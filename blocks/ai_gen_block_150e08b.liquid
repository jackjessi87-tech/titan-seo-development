{% doc %}
  Was the homepage "Recent jobs" showcase. Since 2026-11-20 the showcase is
  snippets/titan-travels-showcase.liquid, rendered near the top of the homepage by
  sections/titan-home-hero.liquid, so this block is intentionally empty.
  The settings below are kept so the template stays valid.
{% enddoc %}
<div {{ block.shopify_attributes }} hidden></div>

