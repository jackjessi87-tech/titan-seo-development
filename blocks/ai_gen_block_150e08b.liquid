{% doc %}
  Homepage photo showcase: "How your furniture travels with us" (rebuilt 2026-11-20).
  Same square photo grid as the landing pages (2 across on phones, 4 on desktop), using the
  homepage photos from Shopify Files plus four real load photos from the theme assets.
  The old per-job settings below are kept so the template stays valid.
{% enddoc %}
{%- liquid
  assign rj_id = block.id | replace: '_', '' | downcase
  assign rj_items = 'f|titan-two-movers-truck-hero.webp|Two movers and the truck;a|titan-load-sofas-wrapped-van.jpg|Sofas shrink-wrapped for the trip;f|titan-fridge-trolley-ramp.webp|Fridges moved upright;a|titan-load-fridge-washer-wrapped.jpg|Fridge and washer wrapped;f|titan-dining-table-two-movers.webp|Tables carried by two;a|titan-load-blankets-straps-trolley.jpg|Blankets, straps and a trolley;f|titan-mattress-delivery-truck.webp|Beds and mattresses;a|titan-load-fridge-washer-van.jpg|Appliances loaded upright' | split: ';'
-%}
<section class="rj" id="recent-jobs" {{ block.shopify_attributes }} aria-labelledby="rj-h-{{ rj_id }}">
  <div class="rj-wrap">
    <div class="rj-head">
      <div>
        <p class="rj-eyebrow">Wrapped, strapped, delivered</p>
        <h2 class="rj-h2" id="rj-h-{{ rj_id }}">How your furniture travels with us</h2>
        <p class="rj-sub">Every item is wrapped, strapped and placed where you want it. Real loads from our trucks and vans across Sydney.</p>
      </div>
      <div class="rj-stats" role="list">
        <div role="listitem"><strong>5.0</strong><span>Google rating</span></div>
        <div role="listitem"><strong>60+</strong><span>5-star reviews</span></div>
        <div role="listitem"><strong>7</strong><span>days a week</span></div>
      </div>
    </div>
    <div class="rj-grid">
      {%- for it in rj_items -%}
        {%- assign f = it | split: '|' -%}
        {%- assign rj_alt = f[2] | append: ' - Titan Express removalists Sydney' -%}
        {%- if f[0] == 'f' -%}
          {%- assign img = images[f[1]] -%}
          {%- if img != blank -%}
            <figure class="rj-shot">
              {{ img | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320, 480, 640', sizes: '(min-width: 900px) 25vw, 50vw', alt: rj_alt }}
              <figcaption>{{ f[2] }}</figcaption>
            </figure>
          {%- endif -%}
        {%- else -%}
          <figure class="rj-shot">
            <img src="{{ f[1] | asset_url }}" width="800" height="800" loading="lazy" alt="{{ rj_alt | escape }}">
            <figcaption>{{ f[2] }}</figcaption>
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="rj-cta">
      <a class="rj-btn rj-btn--q" href="#instant-quote"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>Get my fixed price</a>
      <a class="rj-btn rj-btn--c" href="tel:+61469717535"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>Call 0469 717 535</a>
    </div>
  </div>
</section>

{% style %}
  .rj { --rj-b9:#071a3d; --rj-b6:#0b5cff; --rj-b5:#2f7bff; --rj-mut:#5a6782; font-family: Inter, var(--font-body--family, sans-serif); padding:56px 0; background:radial-gradient(900px 400px at 100% 0%, rgba(47,123,255,.10), transparent 60%), #f5f8ff; width:100%; }
  .rj-wrap { max-width:1180px; margin:0 auto; padding:0 16px; }
  .rj-head { display:grid; gap:18px; margin-bottom:22px; }
  .rj-eyebrow { margin:0 0 6px; font-size:.75rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; color:var(--rj-b6); }
  .rj-h2 { margin:0 0 8px; font-size:clamp(1.45rem,5.6vw,2.2rem); line-height:1.12; font-weight:900; letter-spacing:-.015em; color:var(--rj-b9); }
  .rj-sub { margin:0; color:var(--rj-mut); font-size:1rem; line-height:1.5; max-width:560px; }
  .rj-stats { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
  .rj-stats > div { padding:12px; border-radius:16px; background:#fff; border:1px solid #dfe6f3; text-align:center; box-shadow:0 8px 20px rgba(11,40,99,.06); }
  .rj-stats strong { display:block; font-size:1.5rem; font-weight:900; color:var(--rj-b6); line-height:1.1; }
  .rj-stats span { font-size:.75rem; font-weight:700; color:var(--rj-mut); }
  .rj-grid { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:12px; }
  .rj-shot { position:relative; margin:0; overflow:hidden; border-radius:16px; background:#e8f0ff; aspect-ratio:1; box-shadow:0 12px 28px rgba(7,26,61,.12); }
  .rj-shot img { display:block; width:100%; height:100%; object-fit:cover; transition:transform .6s cubic-bezier(.2,.7,.2,1); }
  .rj-shot:hover img { transform:scale(1.05); }
  .rj-shot figcaption { position:absolute; left:0; right:0; bottom:0; padding:22px 12px 10px; background:linear-gradient(180deg, transparent, rgba(7,26,61,.78)); color:#fff; font-weight:800; font-size:.86rem; line-height:1.25; }
  .rj-cta { display:flex; flex-wrap:wrap; gap:10px; margin-top:20px; }
  .rj-btn { display:inline-flex; align-items:center; gap:8px; padding:14px 22px; border-radius:999px; font-weight:800; font-size:1rem; text-decoration:none; transition:transform .2s, box-shadow .2s; }
  .rj-btn:hover { transform:translateY(-2px); }
  .rj-btn svg { width:18px; height:18px; fill:none; stroke:currentColor; stroke-width:2.2; stroke-linecap:round; stroke-linejoin:round; }
  .rj-btn--q { background:linear-gradient(135deg,#22c55e,#16a34a); color:#fff; box-shadow:0 12px 26px rgba(22,163,74,.35); }
  .rj-btn--q svg { fill:currentColor; stroke:none; }
  .rj-btn--c { background:#fff; color:var(--rj-b6); border:1.5px solid var(--rj-b6); }
  @media (min-width: 900px) {
    .rj { padding:72px 0; }
    .rj-head { grid-template-columns:1.4fr 1fr; align-items:end; }
    .rj-grid { grid-template-columns:repeat(4, minmax(0, 1fr)); gap:16px; }
  }
  @media (prefers-reduced-motion: reduce) { .rj * { transition:none !important; } }
{% endstyle %}

