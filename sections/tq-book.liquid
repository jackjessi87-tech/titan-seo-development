{%- comment -%}
  Hero card for the Quote form (no price), 2026-11-25.
  A team photo behind the heading, an experience line, pick up + drop off boxes that suggest matching suburbs as you type,
  and one button that opens the Quote form on the route map (tq-quote.js wires up every [data-tq-quickstart] form).
  Photos come from Shopify Files (the approved "two movers in blue shirts" set). No price anywhere.
  Made from the TX card (tx-book.liquid), which stays as it is; this one uses its own class names (tqb).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign phone_intl = s.phone | remove: ' ' | remove_first: '0' | prepend: '+61'
  assign bg = images[s.photo_file]
  assign g1 = images['titan-fridge-trolley-ramp.webp']
  assign g2 = images['titan-mattress-delivery-truck.webp']
  assign g3 = images['titan-sofa-truck-loading.webp']
-%}
<section class="tqb{% if bg != blank %} tqb--photo{% endif %}" aria-labelledby="tqb-h-{{ section.id }}"{% if bg != blank %} style="--tqb-photo: url('{{ bg | image_url: width: 1100 }}'); --tqb-photo-lg: url('{{ bg | image_url: width: 2000 }}');"{% endif %}>
  <div class="tqb__in">
    <div class="tqb__top">
      {%- if s.show_logo -%}<a class="tqb__logo" href="/" aria-label="Titan Express home"><img src="{{ 'titan-favicon-192.png' | asset_url }}" alt="Titan Express" width="48" height="48"></a>{%- endif -%}
      <ul class="tqb__chips">
        {%- if s.chip_1 != blank -%}<li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.200 9.500l6.100-.9z"/></svg>{{ s.chip_1 }}</li>{%- endif -%}
        {%- if s.chip_2 != blank -%}<li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.500-3 8.300-7 10-4-1.700-7-5.500-7-10V6z"/><path d="M9 12l2 2 4-4.500"/></svg>{{ s.chip_2 }}</li>{%- endif -%}
      </ul>
    </div>
    <p class="tqb__eb">{{ s.eyebrow }}</p>
    <h2 class="tqb__h" id="tqb-h-{{ section.id }}">{{ s.heading_before }} <span>{{ s.heading_price }}</span></h2>
    <p class="tqb__sub">{{ s.subheading }}</p>
    <form class="tqb__card" action="{{ s.quote_url }}" method="get" data-tq-quickstart autocomplete="off">
      <div class="tqb__f" data-tq-field>
        <span class="tqb__pin tqb__pin--a" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s-7-6.200-7-11.500A7 7 0 0 1 19 9.500C19 14.800 12 21 12 21z"/><circle cx="12" cy="9.500" r="2.500"/></svg></span>
        <label class="tqb__fl" for="tqb-from-{{ section.id }}">Pick up from</label>
        <input id="tqb-from-{{ section.id }}" name="from" type="text" autocomplete="off" autocapitalize="words" spellcheck="false" placeholder="Type a suburb or address" role="combobox" aria-expanded="false" aria-autocomplete="list">
        <span class="tqb__ok" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.500l4.500 4.500L19 7"/></svg></span>
        <div class="tqb__sugg" data-tq-sugg hidden role="listbox"></div>
      </div>
      <div class="tqb__line" aria-hidden="true"></div>
      <div class="tqb__f" data-tq-field>
        <span class="tqb__pin tqb__pin--b" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 21V4"/><path d="M5 4h14v9H5"/></svg></span>
        <label class="tqb__fl" for="tqb-to-{{ section.id }}">Drop off at</label>
        <input id="tqb-to-{{ section.id }}" name="to" type="text" autocomplete="off" autocapitalize="words" spellcheck="false" placeholder="Type a suburb or address" role="combobox" aria-expanded="false" aria-autocomplete="list">
        <span class="tqb__ok" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.500l4.500 4.500L19 7"/></svg></span>
        <div class="tqb__sugg" data-tq-sugg hidden role="listbox"></div>
      </div>
      <button class="tqb__go" type="submit"><span data-tq-golbl>{{ s.button }}</span> <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
      <p class="tqb__under">{{ s.under_button }}</p>
    </form>
    <ul class="tqb__trust">
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.500l4.500 4.500L19 7"/></svg>{{ s.point_1 }}</li>
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.500l4.500 4.500L19 7"/></svg>{{ s.point_2 }}</li>
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.500l4.500 4.500L19 7"/></svg>{{ s.point_3 }}</li>
    </ul>
    {%- if s.show_gallery and g1 != blank and g2 != blank and g3 != blank -%}
    <div class="tqb__team">
      <p class="tqb__teamh">{{ s.team_heading }}</p>
      <p class="tqb__teamp">{{ s.team_text }}</p>
      <ul class="tqb__gal">
        <li><img src="{{ g1 | image_url: width: 420 }}" alt="Two Titan Express removalists moving a wrapped fridge down the truck ramp on a trolley" width="420" height="420" loading="lazy"><span>{{ s.cap_1 }}</span></li>
        <li><img src="{{ g2 | image_url: width: 420 }}" alt="Titan Express removalists unloading a covered mattress from the truck" width="420" height="420" loading="lazy"><span>{{ s.cap_2 }}</span></li>
        <li><img src="{{ g3 | image_url: width: 420 }}" alt="Two Titan Express removalists loading a wrapped sofa into the truck" width="420" height="420" loading="lazy"><span>{{ s.cap_3 }}</span></li>
      </ul>
    </div>
    {%- endif -%}
    <p class="tqb__call">Prefer to talk? <a href="tel:{{ phone_intl }}">Call {{ s.phone }}</a></p>
  </div>
</section>

<style>
  .tqb { position: relative; background: linear-gradient(180deg, #0b1b44 0%, #17357f 100%); color: #fff; padding: 20px 16px clamp(30px, 6vw, 60px); font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  .tqb *, .tqb *::before, .tqb *::after { box-sizing: border-box; }
  /* team photo behind the top of the card: clear at the top, fading into navy where the text starts */
  .tqb--photo { background: linear-gradient(180deg, rgba(11,27,68,.28) 0, rgba(11,27,68,.18) 90px, rgba(11,27,68,.72) 190px, #0b1b44 262px, #17357f 100%), var(--tqb-photo) center top / 100% auto no-repeat, #0b1b44; }
  .tqb__in { max-width: 560px; margin: 0 auto; text-align: center; }
  .tqb__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; min-height: 48px; }
  .tqb--photo .tqb__top { margin-bottom: 118px; }
  .tqb__logo { display: block; flex: none; }
  .tqb__logo img { width: 48px; height: 48px; border-radius: 50%; background: #fff; box-shadow: 0 4px 14px rgba(0,0,0,.3); display: block; }
  .tqb__chips { list-style: none; margin: 0 0 0 auto; padding: 0; display: grid; gap: 6px; justify-items: end; }
  .tqb__chips li { display: inline-flex; align-items: center; gap: 6px; background: rgba(255,255,255,.96); color: #0b1b44; border-radius: 999px; padding: 6px 12px 6px 9px; font-size: .8rem; font-weight: 800; box-shadow: 0 6px 16px rgba(0,0,0,.25); white-space: nowrap; }
  .tqb__chips svg { width: 16px; height: 16px; fill: none; stroke: #e1261c; stroke-width: 2.200; stroke-linecap: round; stroke-linejoin: round; }
  .tqb__chips li:first-child svg { fill: #fbbf24; stroke: #fbbf24; }
  .tqb__eb { margin: 0 0 8px; font-size: .76rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: #ffb3ae; text-shadow: 0 1px 8px rgba(0,0,0,.5); }
  .tqb__h { margin: 0; font: 800 clamp(2rem, 8vw, 3.100rem)/1.060 "Plus Jakarta Sans", Inter, sans-serif; letter-spacing: -.030em; color: #fff; text-shadow: 0 2px 14px rgba(0,0,0,.45); }
  .tqb__h span { color: #fff; background: #e1261c; padding: 0 .18em; border-radius: .18em; white-space: nowrap; text-shadow: none; }
  .tqb__sub { margin: 12px 0 18px; font-size: 1.040rem; line-height: 1.450; color: rgba(255,255,255,.9); }
  .tqb__card { background: #fff; border-radius: 18px; padding: 10px 12px 12px; box-shadow: 0 20px 50px rgba(0,0,0,.32); text-align: left; position: relative; }
  .tqb__f { position: relative; display: grid; grid-template-columns: 38px 1fr 26px; grid-template-rows: auto auto; column-gap: 12px; align-items: center; padding: 8px 4px; }
  .tqb__pin { grid-row: 1 / 3; width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; }
  .tqb__pin svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2.200; stroke-linecap: round; stroke-linejoin: round; }
  .tqb__pin--a { background: #fdecea; color: #e1261c; }
  .tqb__pin--b { background: #e7ecfb; color: #17357f; }
  .tqb__fl { grid-column: 2; font-size: .74rem; font-weight: 800; letter-spacing: .040em; text-transform: uppercase; color: #5d6475; cursor: text; }
  .tqb__f input { grid-column: 2; width: 100%; min-width: 0; border: 0; outline: 0; padding: 2px 0 4px; margin: 0; font: 600 16px/1.300 Inter, sans-serif; color: #0f1218; background: transparent; box-shadow: none; border-radius: 0; text-overflow: ellipsis; }
  .tqb__f input::placeholder { color: #9aa1b0; font-weight: 500; }
  .tqb__f:focus-within .tqb__fl { color: #17357f; }
  .tqb__ok { grid-column: 3; grid-row: 1 / 3; width: 24px; height: 24px; border-radius: 50%; background: #12a05c; display: none; place-items: center; }
  .tqb__ok svg { width: 14px; height: 14px; fill: none; stroke: #fff; stroke-width: 3.200; stroke-linecap: round; stroke-linejoin: round; }
  .tqb__f.is-set .tqb__ok { display: grid; }
  .tqb__line { height: 1px; background: #e3e6ee; margin: 0 4px 0 54px; }
  /* suggestions under the box you are typing in */
  .tqb__sugg { position: absolute; left: 0; right: 0; top: calc(100% - 2px); z-index: 30; background: #fff; border: 1px solid #dfe3ec; border-radius: 14px; box-shadow: 0 18px 40px rgba(11,27,68,.28); overflow: hidden; }
  .tqb__sugg[hidden] { display: none; }
  .tqb__sugg button { display: flex; align-items: center; gap: 10px; width: 100%; border: 0; border-top: 1px solid #eef0f5; background: #fff; padding: 11px 12px; text-align: left; cursor: pointer; font: inherit; color: #0f1218; }
  .tqb__sugg button:first-child { border-top: 0; }
  .tqb__sugg button:hover, .tqb__sugg button.is-on { background: #eef3ff; }
  .tqb__sugg button[disabled] { cursor: default; color: #5d6475; background: #fff; }
  .tqb__sugg svg { width: 18px; height: 18px; flex: none; fill: none; stroke: #17357f; stroke-width: 2.200; stroke-linecap: round; stroke-linejoin: round; }
  .tqb__sugg b { display: block; font-size: .95rem; font-weight: 700; line-height: 1.250; }
  .tqb__sugg small { display: block; font-size: .8rem; color: #5d6475; line-height: 1.250; }
  .tqb__go { width: 100%; margin-top: 10px; display: inline-flex; align-items: center; justify-content: center; gap: 10px; border: 0; border-radius: 14px; padding: 17px 18px; background: #e1261c; color: #fff; font: 800 1.080rem/1 Inter, sans-serif; letter-spacing: .010em; cursor: pointer; box-shadow: 0 10px 22px rgba(225,38,28,.35); transition: transform .08s, background .15s; }
  .tqb__go:hover { background: #c71e15; }
  .tqb__go:active { transform: scale(.985); }
  .tqb__go[disabled] { opacity: .8; cursor: progress; }
  .tqb__go svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2.400; stroke-linecap: round; stroke-linejoin: round; }
  .tqb__under { margin: 9px 4px 0; text-align: center; font-size: .84rem; color: #5d6475; }
  .tqb__under:empty { display: none; }
  .tqb__trust { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 16px; font-size: .9rem; color: rgba(255,255,255,.92); }
  .tqb__trust li { display: inline-flex; align-items: center; gap: 6px; }
  .tqb__trust svg { width: 16px; height: 16px; fill: none; stroke: #4ade80; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .tqb__team { margin: 26px 0 0; padding: 18px 14px 14px; border-radius: 18px; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.16); }
  .tqb__teamh { margin: 0; font: 800 1.200rem/1.200 "Plus Jakarta Sans", Inter, sans-serif; color: #fff; }
  .tqb__teamp { margin: 6px 0 14px; font-size: .92rem; line-height: 1.450; color: rgba(255,255,255,.86); }
  .tqb__gal { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .tqb__gal li { position: relative; border-radius: 12px; overflow: hidden; background: #0b1b44; aspect-ratio: 1 / 1; }
  .tqb__gal img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tqb__gal span { position: absolute; left: 0; right: 0; bottom: 0; padding: 18px 6px 7px; background: linear-gradient(180deg, rgba(11,27,68,0), rgba(11,27,68,.92)); font-size: .74rem; font-weight: 700; line-height: 1.200; color: #fff; }
  .tqb__call { margin: 16px 0 0; font-size: .92rem; color: rgba(255,255,255,.8); }
  .tqb__call a { color: #fff; font-weight: 800; text-decoration: underline; text-underline-offset: 3px; }
  /* wide screens: the photo fills the right side, the words and the card sit on the left */
  @media (min-width: 900px) {
    .tqb { padding: 34px 32px 56px; }
    .tqb--photo { background: linear-gradient(90deg, #0b1b44 0%, rgba(11,27,68,.94) 38%, rgba(11,27,68,.55) 62%, rgba(11,27,68,.12) 100%), var(--tqb-photo-lg) right center / auto 100% no-repeat, #0b1b44; }
    .tqb__in { max-width: 1120px; text-align: left; }
    .tqb__in > * { max-width: 540px; }
    .tqb--photo .tqb__top { margin-bottom: 28px; }
    .tqb__chips { margin: 0; justify-items: start; grid-auto-flow: column; }
    .tqb__top { justify-content: flex-start; gap: 16px; align-items: center; }
    .tqb__trust { justify-content: flex-start; }
  }
</style>

{% schema %}
{
  "name": "Quote card (no price)",
  "tag": "div",
  "class": "section-tq-book",
  "settings": [
    { "type": "checkbox", "id": "show_logo", "label": "Show Titan badge at top", "info": "Use when this section is the first thing on the page.", "default": false },
    { "type": "text", "id": "photo_file", "label": "Background photo (file name)", "info": "A photo in Content > Files. Leave empty for plain navy.", "default": "titan-dining-table-two-movers.webp" },
    { "type": "text", "id": "chip_1", "label": "Badge 1", "default": "5.0 on Google" },
    { "type": "text", "id": "chip_2", "label": "Badge 2", "default": "10+ years' experience" },
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "Sydney removalists & delivery" },
    { "type": "text", "id": "heading_before", "label": "Heading", "default": "Get a fast," },
    { "type": "text", "id": "heading_price", "label": "Heading highlight", "default": "free quote" },
    { "type": "text", "id": "subheading", "label": "Line under heading", "default": "Experienced removalists who wrap, lift and deliver with care. Tell us where from and where to." },
    { "type": "text", "id": "button", "label": "Button", "default": "Get my free quote" },
    { "type": "text", "id": "under_button", "label": "Line under button", "default": "Takes about a minute. No obligation." },
    { "type": "text", "id": "point_1", "label": "Tick 1", "default": "Same-day available" },
    { "type": "text", "id": "point_2", "label": "Tick 2", "default": "Wrapped & carried with care" },
    { "type": "text", "id": "point_3", "label": "Tick 3", "default": "Trolleys, ramps & blankets" },
    { "type": "checkbox", "id": "show_gallery", "label": "Show the team photos", "default": true },
    { "type": "text", "id": "team_heading", "label": "Team heading", "default": "Removalists with 10+ years' experience" },
    { "type": "text", "id": "team_text", "label": "Team text", "default": "Trained, careful and on time. We wrap your furniture, bring the right gear and treat your home with respect." },
    { "type": "text", "id": "cap_1", "label": "Photo 1 caption", "default": "Fridges & appliances" },
    { "type": "text", "id": "cap_2", "label": "Photo 2 caption", "default": "Beds & mattresses" },
    { "type": "text", "id": "cap_3", "label": "Photo 3 caption", "default": "Sofas & furniture" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "0469 717 535" },
    { "type": "text", "id": "quote_url", "label": "Fallback quote page", "default": "/pages/furniture-pickup-delivery-sydney" }
  ],
  "presets": [{ "name": "Quote card (no price)" }]
}
{% endschema %}
