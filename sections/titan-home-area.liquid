{%- doc -%}
  Titan Express "where we work + what customers say" section.
  Replaces the Google reviews app widget on the homepage.
  Left: a live street map of Sydney with the 20 km service area drawn
  around the CBD (map tiles load only when the section is near the screen).
  Right: the Google star score and real Google reviews (one block each).
  No app, no outside script; the map is a few image tiles and an SVG ring.
{%- enddoc -%}

{%- liquid
  assign s = section.settings
  assign phone_digits = s.phone | remove: ' '
  assign phone_intl = phone_digits | remove_first: '0' | prepend: '+61'
  assign reviews = section.blocks | where: 'type', 'review'
  assign areas = s.areas | split: ','
-%}
{%- capture star -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z"/></svg>{%- endcapture -%}
{%- capture stars5 -%}<span class="tha-stars" aria-hidden="true">{{ star }}{{ star }}{{ star }}{{ star }}{{ star }}</span>{%- endcapture -%}
{%- capture g_logo -%}<svg class="tha-g" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9 3.5l6.7-6.7C35.6 2.4 30.2 0 24 0 14.6 0 6.6 5.4 2.6 13.2l7.8 6.1C12.3 13.6 17.6 9.5 24 9.5z"/><path fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.4c-.5 2.9-2.2 5.3-4.6 6.9l7.5 5.8c4.4-4 6.8-10 6.8-17.2z"/><path fill="#FBBC05" d="M10.4 28.7c-.5-1.4-.8-3-.8-4.7s.3-3.2.8-4.7l-7.8-6.1C1 16.5 0 20.1 0 24s1 7.5 2.6 10.8l7.8-6.1z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.5-5.8c-2.1 1.4-4.8 2.3-8.4 2.3-6.4 0-11.7-4.1-13.6-9.8l-7.8 6.1C6.6 42.6 14.6 48 24 48z"/></svg>{%- endcapture -%}
{%- capture i_phone -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>{%- endcapture -%}
{%- capture i_truck -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>{%- endcapture -%}
{%- capture i_quote -%}<svg class="tha-qm" viewBox="0 0 32 24" aria-hidden="true"><path d="M0 24V14C0 6 4 1.5 12 0l1.5 3C9 4.5 7 7.5 7 11h6v13zm18 0V14c0-8 4-12.5 12-14l1.5 3C27 4.5 25 7.5 25 11h6v13z"/></svg>{%- endcapture -%}

<section class="tha" id="tha-{{ section.id }}" aria-labelledby="tha-h-{{ section.id }}">
  <div class="tha-wrap">
    <header class="tha-head">
      <p class="tha-eyebrow">{{ s.eyebrow }}</p>
      <h2 class="tha-h2" id="tha-h-{{ section.id }}">{{ s.heading }}</h2>
      <p class="tha-lead">{{ s.lead }}</p>
    </header>

    <div class="tha-grid">
      <div class="tha-mapcard">
        <div class="tha-map" data-tha-map data-lat="{{ s.center_lat }}" data-lon="{{ s.center_lon }}" data-km="{{ s.radius_km }}" role="img" aria-label="Map of Sydney showing the Titan Express service area, about {{ s.radius_km }} km around the Sydney CBD">
          <div class="tha-tiles" data-tha-tiles></div>
          <svg class="tha-ring" data-tha-ring aria-hidden="true"></svg>
          <div class="tha-pins" data-tha-pins aria-hidden="true"></div>
          <span class="tha-badge">{{ i_truck }}<span>{{ s.radius_km }} km around the city</span></span>
        </div>
        <div class="tha-mapfoot">
          <ul class="tha-areas" aria-label="Areas we cover">
            {%- for a in areas -%}<li>{{ a | strip }}</li>{%- endfor -%}
          </ul>
          <p class="tha-note">{{ s.note }}</p>
          <p class="tha-attr">Map tiles &copy; Esri</p>
        </div>
      </div>

      <div class="tha-rev">
        <a class="tha-score" href="{{ s.reviews_url }}" target="_blank" rel="noopener">
          {{ g_logo }}
          <span class="tha-score__num">{{ s.rating }}</span>
          <span class="tha-score__txt">{{ stars5 }}<span>{{ s.review_count }} Google reviews &middot; {{ s.score_line }}</span></span>
        </a>
        <p class="tha-revh">What our customers say</p>
        <div class="tha-cards" role="list">
          {%- for b in reviews -%}
            <figure class="tha-card" role="listitem" {{ b.shopify_attributes }}>
              <div class="tha-card__top">{{ stars5 }}{%- if b.settings.tag != blank -%}<span class="tha-tag">{{ b.settings.tag }}</span>{%- endif -%}</div>
              <blockquote class="tha-card__q">{{ i_quote }}<p>{{ b.settings.text }}</p></blockquote>
              <figcaption class="tha-card__by"><span class="tha-av" aria-hidden="true">{{ b.settings.name | slice: 0 }}</span><span><strong>{{ b.settings.name }}</strong><small>{{ g_logo }}Google review</small></span></figcaption>
            </figure>
          {%- endfor -%}
        </div>
        <div class="tha-ctas">
          <a class="tha-btn tha-btn--call" href="tel:{{ phone_intl }}">{{ i_phone }}<span>Call {{ s.phone }}</span></a>
          <a class="tha-btn tha-btn--ghost" href="{{ s.reviews_url }}" target="_blank" rel="noopener">{{ g_logo }}<span>Read all reviews</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #tha-{{ section.id }} { --b9:#071a3d; --b8:#0a2a63; --b6:#0b5cff; --b5:#2f7bff; --b1:#e8f0ff; --b0:#f5f8ff; --mut:#5a6782; --gold:#fbbc05;
    background:linear-gradient(180deg,#fff 0%,var(--b0) 100%); color:var(--b9); padding:clamp(40px,7vw,80px) 0; font-family:inherit; }
  #tha-{{ section.id }} * { box-sizing:border-box; }
  .tha-wrap { max-width:1180px; margin:0 auto; padding:0 16px; }
  .tha-head { text-align:center; max-width:760px; margin:0 auto clamp(22px,4vw,36px); }
  .tha-eyebrow { display:inline-block; margin:0 0 10px; padding:6px 12px; border-radius:999px; background:var(--b1); color:var(--b6); font-size:.78rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
  .tha-h2 { margin:0 0 10px; font-size:clamp(1.6rem,4.6vw,2.5rem); line-height:1.1; font-weight:900; letter-spacing:-.02em; text-wrap:balance; }
  .tha-h2 em { font-style:normal; color:var(--b6); }
  .tha-lead { margin:0; color:var(--mut); font-size:1.02rem; line-height:1.55; }
  .tha-grid { display:grid; gap:20px; grid-template-columns:1fr; align-items:start; }
  @media (min-width:900px){ .tha-grid { grid-template-columns:1.05fr 1fr; gap:28px; } }

  .tha-mapcard { background:#fff; border:1px solid #dfe7f7; border-radius:22px; overflow:hidden; box-shadow:0 18px 40px -24px rgba(7,26,61,.35); }
  .tha-map { position:relative; height:clamp(300px,62vw,440px); background:#e9eef6; overflow:hidden; }
  .tha-tiles { position:absolute; left:0; top:0; transform-origin:0 0; }
  .tha-tiles img { position:absolute; width:256px; height:256px; max-width:none; display:block; user-select:none; -webkit-user-drag:none; }
  .tha-ring { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; }
  .tha-ring .glow { animation:tha-pulse 2.8s ease-out infinite; transform-box:fill-box; transform-origin:center; }
  @keyframes tha-pulse { 0%{ opacity:.55; transform:scale(.96);} 100%{ opacity:0; transform:scale(1.08);} }
  .tha-pins { position:absolute; inset:0; pointer-events:none; }
  .tha-pin { position:absolute; transform:translate(-5px,-50%); display:flex; align-items:center; gap:5px; white-space:nowrap; font-size:.72rem; font-weight:800; color:var(--b9); }
  .tha-pin i { width:9px; height:9px; border-radius:50%; background:var(--b6); box-shadow:0 0 0 3px #fff, 0 2px 6px rgba(7,26,61,.4); flex:none; }
  .tha-pin span { background:rgba(255,255,255,.92); padding:2px 7px; border-radius:999px; box-shadow:0 2px 6px rgba(7,26,61,.18); }
  .tha-pin--cbd { z-index:2; flex-direction:column-reverse; gap:5px; font-size:.78rem; transform:translate(-50%,calc(-100% + 8px)); }
  .tha-pin--cbd i { width:16px; height:16px; background:var(--b9); box-shadow:0 0 0 4px #fff, 0 0 0 9px rgba(11,92,255,.35); }
  .tha-pin--cbd span { background:var(--b9); color:#fff; }
  .tha-badge { position:absolute; left:12px; top:12px; display:inline-flex; align-items:center; gap:7px; padding:8px 12px; border-radius:999px; background:var(--b6); color:#fff; font-weight:800; font-size:.84rem; box-shadow:0 10px 22px -10px rgba(11,92,255,.8); }
  .tha-badge svg { width:18px; height:18px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
  .tha-mapfoot { padding:14px 16px 12px; }
  .tha-areas { list-style:none; margin:0 0 10px; padding:0; display:flex; flex-wrap:wrap; gap:7px; }
  .tha-areas li { padding:6px 11px; border-radius:999px; background:var(--b0); border:1px solid #dfe7f7; font-size:.82rem; font-weight:700; color:var(--b8); }
  .tha-note { margin:0 0 4px; font-size:.9rem; color:var(--mut); line-height:1.45; }
  .tha-attr { margin:0; font-size:.68rem; color:#97a3ba; text-align:right; }

  .tha-rev { min-width:0; }
  .tha-score { display:flex; align-items:center; gap:14px; padding:16px 18px; border-radius:20px; background:var(--b9); color:#fff; text-decoration:none; box-shadow:0 18px 40px -22px rgba(7,26,61,.6); }
  .tha-score .tha-g { width:34px; height:34px; flex:none; background:#fff; border-radius:50%; padding:6px; }
  .tha-score__num { font-size:2.6rem; font-weight:900; line-height:1; letter-spacing:-.03em; }
  .tha-score__txt { display:flex; flex-direction:column; gap:4px; font-size:.88rem; color:#cfe0ff; }
  .tha-stars { display:inline-flex; gap:2px; }
  .tha-stars svg { width:18px; height:18px; fill:var(--gold); }
  .tha-revh { margin:20px 0 10px; font-size:1.05rem; font-weight:900; }
  .tha-cards { display:grid; grid-auto-flow:column; grid-auto-columns:minmax(260px,84%); gap:12px; overflow-x:auto; scroll-snap-type:x mandatory; padding:2px 2px 12px; margin:0 -2px; scrollbar-width:thin; }
  @media (min-width:640px){ .tha-cards { grid-auto-flow:row; grid-template-columns:1fr 1fr; grid-auto-columns:auto; overflow:visible; } }
  .tha-card { margin:0; scroll-snap-align:start; display:flex; flex-direction:column; gap:10px; padding:16px; background:#fff; border:1px solid #dfe7f7; border-radius:18px; box-shadow:0 10px 26px -22px rgba(7,26,61,.5); }
  .tha-card__top { display:flex; align-items:center; justify-content:space-between; gap:8px; }
  .tha-card .tha-stars svg { width:15px; height:15px; }
  .tha-tag { font-size:.7rem; font-weight:800; color:var(--b6); background:var(--b1); padding:4px 9px; border-radius:999px; white-space:nowrap; }
  .tha-card__q { margin:0; position:relative; flex:1; }
  .tha-qm { position:absolute; right:0; top:-2px; width:28px; fill:var(--b1); }
  .tha-card__q p { margin:0; position:relative; font-size:.93rem; line-height:1.5; color:#24314d; }
  .tha-card__by { display:flex; align-items:center; gap:10px; font-size:.86rem; }
  .tha-card__by strong { display:block; color:var(--b9); }
  .tha-card__by small { display:inline-flex; align-items:center; gap:4px; color:var(--mut); font-size:.74rem; }
  .tha-card__by small .tha-g { width:12px; height:12px; }
  .tha-av { width:34px; height:34px; border-radius:50%; display:grid; place-items:center; flex:none; background:linear-gradient(135deg,var(--b5),var(--b9)); color:#fff; font-weight:900; text-transform:uppercase; }
  .tha-ctas { display:flex; flex-wrap:wrap; gap:10px; margin-top:16px; }
  .tha-btn { flex:1 1 200px; display:inline-flex; align-items:center; justify-content:center; gap:8px; min-height:52px; padding:12px 18px; border-radius:14px; font-weight:800; font-size:1rem; text-decoration:none; }
  .tha-btn svg { width:20px; height:20px; }
  .tha-btn--call { background:var(--b6); color:#fff; box-shadow:0 14px 26px -14px rgba(11,92,255,.9); }
  .tha-btn--call svg { fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
  .tha-btn--ghost { background:#fff; color:var(--b9); border:1.5px solid #cfdaf0; }
  @media (prefers-reduced-motion:reduce){ .tha-ring .glow { animation:none; opacity:0; } }
</style>

<script>
(function(){
  var root = document.getElementById('tha-{{ section.id }}'); if (!root) return;
  var map = root.querySelector('[data-tha-map]'); if (!map) return;
  var TILE = 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/';
  var PINS = {{ s.pins | default: '' | json }};
  var lat = parseFloat(map.dataset.lat), lon = parseFloat(map.dataset.lon), km = parseFloat(map.dataset.km) || 20;
  var Z = 10, N = Math.pow(2, Z), drawnW = 0;
  function px(la, lo){ var r = la * Math.PI / 180; return { x:(lo + 180) / 360 * N * 256, y:(1 - Math.log(Math.tan(r) + 1 / Math.cos(r)) / Math.PI) / 2 * N * 256 }; }
  function draw(){
    var w = map.clientWidth, h = map.clientHeight; if (!w || !h || w === drawnW) return; drawnW = w;
    var c = px(lat, lon);
    var mpp = 156543.034 * Math.cos(lat * Math.PI / 180) / N;
    var r0 = km * 1000 / mpp;
    var sc = Math.max(.8, Math.min(1.7, Math.min(w, h) * .42 / r0));
    var vw = w / sc, vh = h / sc, x0 = c.x - vw / 2, y0 = c.y - vh / 2;
    var tiles = map.querySelector('[data-tha-tiles]'); tiles.innerHTML = '';
    tiles.style.width = vw + 'px'; tiles.style.height = vh + 'px'; tiles.style.transform = 'scale(' + sc + ')';
    for (var tx = Math.floor(x0 / 256); tx <= Math.floor((x0 + vw) / 256); tx++) {
      for (var ty = Math.floor(y0 / 256); ty <= Math.floor((y0 + vh) / 256); ty++) {
        var im = new Image(); im.alt = ''; im.decoding = 'async'; im.loading = 'lazy';
        im.src = TILE + Z + '/' + ty + '/' + tx; im.style.left = (tx * 256 - x0) + 'px'; im.style.top = (ty * 256 - y0) + 'px';
        tiles.appendChild(im);
      }
    }
    var r = r0 * sc, cx = w / 2, cy = h / 2, id = 'thm{{ section.id | handle }}';
    map.querySelector('[data-tha-ring]').innerHTML =
      '<defs><mask id="' + id + '"><rect width="100%" height="100%" fill="#fff"/><circle cx="' + cx + '" cy="' + cy + '" r="' + r + '" fill="#000"/></mask></defs>' +
      '<rect width="100%" height="100%" fill="rgba(7,26,61,.38)" mask="url(#' + id + ')"/>' +
      '<circle cx="' + cx + '" cy="' + cy + '" r="' + r + '" fill="rgba(11,92,255,.07)" stroke="#0b5cff" stroke-width="3"/>' +
      '<circle class="glow" cx="' + cx + '" cy="' + cy + '" r="' + r + '" fill="none" stroke="#2f7bff" stroke-width="10"/>' +
      '<circle cx="' + cx + '" cy="' + cy + '" r="' + r + '" fill="none" stroke="#fff" stroke-width="1.5" stroke-dasharray="2 9" stroke-linecap="round"/>';
    var pins = map.querySelector('[data-tha-pins]');
    var html = '<span class="tha-pin tha-pin--cbd" style="left:' + cx + 'px;top:' + cy + 'px"><i></i><span>Sydney CBD</span></span>';
    var boxes = [[0, 0, 230, 54], [cx - 48, cy - 40, cx + 48, cy + 12]];
    function hit(b){ for (var k = 0; k < boxes.length; k++) { var o = boxes[k]; if (b[0] < o[2] && b[2] > o[0] && b[1] < o[3] && b[3] > o[1]) return true; } return false; }
    (PINS || '').split(';').forEach(function(p){
      var a = p.split('|'); if (a.length < 3) return;
      var q = px(parseFloat(a[1]), parseFloat(a[2]));
      var x = (q.x - x0) * sc, y = (q.y - y0) * sc;
      var b = [x - 7, y - 12, x + 22 + a[0].length * 6.8, y + 12];
      if (b[0] < 4 || b[1] < 4 || b[2] > w - 4 || b[3] > h - 4 || hit(b)) return;
      boxes.push(b);
      html += '<span class="tha-pin" style="left:' + x + 'px;top:' + y + 'px"><i></i><span>' + a[0] + '</span></span>';
    });
    pins.innerHTML = html;
  }
  function start(){ draw(); var t; window.addEventListener('resize', function(){ clearTimeout(t); t = setTimeout(draw, 150); }); }
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(es){ if (es[0].isIntersecting) { io.disconnect(); start(); } }, { rootMargin:'400px' });
    io.observe(map);
  } else { start(); }
})();
</script>

{% schema %}
{
  "name": "Area map and reviews",
  "tag": "div",
  "class": "titan-home-area",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Where we work" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Two men &amp; a mini truck, all over <em>Sydney</em>" },
    { "type": "textarea", "id": "lead", "label": "Intro", "default": "Small moves and furniture pickup and delivery, about 20 km around the Sydney CBD, 7 days a week." },
    { "type": "text", "id": "center_lat", "label": "Map centre latitude", "default": "-33.8688" },
    { "type": "text", "id": "center_lon", "label": "Map centre longitude", "default": "151.2093" },
    { "type": "number", "id": "radius_km", "label": "Service radius (km)", "default": 20 },
    { "type": "textarea", "id": "pins", "label": "Map labels (Name|lat|lon; ...)", "default": "Punchbowl|-33.9269|151.0608;Chatswood|-33.7969|151.1803;Bondi|-33.8915|151.2767;Hurstville|-33.9670|151.1020;Ryde|-33.8150|151.1050;Strathfield|-33.8737|151.0939;Mascot|-33.9300|151.1870;Manly|-33.7969|151.2840" },
    { "type": "text", "id": "areas", "label": "Area list (comma separated)", "default": "City & Inner West, Eastern Suburbs, Lower North Shore, Ryde, Parramatta, Canterbury-Bankstown, St George, Botany Bay" },
    { "type": "text", "id": "note", "label": "Note under the map", "default": "Just outside the circle? Ask us, we often go further." },
    { "type": "text", "id": "rating", "label": "Star rating", "default": "5.0" },
    { "type": "number", "id": "review_count", "label": "Number of Google reviews", "default": 67 },
    { "type": "text", "id": "score_line", "label": "Line after the count", "default": "every one 5 stars" },
    { "type": "text", "id": "reviews_url", "label": "Google reviews link", "default": "https://maps.google.com/?cid=1568429248109187940" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "0469 717 535" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Google review",
      "settings": [
        { "type": "text", "id": "name", "label": "Name (first name and initial)" },
        { "type": "text", "id": "tag", "label": "Job (short)" },
        { "type": "textarea", "id": "text", "label": "Review text (copy exactly from Google)" }
      ]
    }
  ],
  "presets": [ { "name": "Area map and reviews" } ]
}
{% endschema %}
