{%- comment -%} Titan Express redesign: final call-to-action band. Marked data-tx-end so the mobile action bar steps aside here. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign phone_intl = s.phone | remove: ' ' | remove_first: '0' | prepend: '+61'
-%}
<section class="tx txc" aria-labelledby="txc-h-{{ section.id }}" data-tx-end>
  <div class="tx-wrap">
    <div class="txc__box tx-reveal">
      <div class="txc__copy">
        <p class="tx-eyebrow">{{ s.eyebrow }}</p>
        <h2 class="tx-h2" id="txc-h-{{ section.id }}">{{ s.heading }}</h2>
        <p class="tx-lede">{{ s.text }}</p>
        <div class="txc__btns">
          <a class="tx-btn" href="tel:{{ phone_intl }}">{% render 'tx-icon', name: 'phone' %}Call {{ s.phone }}</a>
          <a class="tx-btn tx-btn--light" href="{{ s.quote_url }}" data-tx-open-quote>{% render 'tx-icon', name: 'bolt' %}Instant quote</a>
        </div>
        <ul class="txc__ticks" role="list">
          <li>{% render 'tx-icon', name: 'check' %}$99 covers the first 30 minutes</li>
          <li>{% render 'tx-icon', name: 'check' %}Blankets, straps and trolleys included</li>
          <li>{% render 'tx-icon', name: 'check' %}7 days, 7am to 7pm</li>
        </ul>
      </div>
      {%- if s.image != blank -%}
        <div class="txc__img tx-imgreveal">{{ s.image | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(min-width: 1000px) 460px, 92vw', loading: 'lazy', alt: s.image_alt }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .txc { padding: 0 0 var(--tx-space); background: #fff; }
  .txc__box { display: grid; grid-template-columns: 1.2fr .8fr; gap: clamp(24px, 4vw, 56px); align-items: center; background: var(--tx-navy-900); border-radius: 32px;
    padding: clamp(28px, 5vw, 64px); overflow: hidden; position: relative; isolation: isolate; color: rgba(255, 255, 255, .78); }
  .txc__box::before { content: ""; position: absolute; z-index: -1; left: -10%; bottom: -60%; width: 70%; height: 140%; background: radial-gradient(closest-side, rgba(23, 53, 127, .9), transparent); }
  .txc__box::after { content: ""; position: absolute; z-index: -1; right: -10%; top: -50%; width: 60%; height: 120%; background: radial-gradient(closest-side, rgba(225, 38, 28, .32), transparent);
    animation: txc-drift 14s ease-in-out infinite alternate; }
  @keyframes txc-drift { to { transform: translate(-40px, 30px); } }
  .txc .tx-h2 { color: #fff; }
  .txc .tx-eyebrow { color: #ff8a83; }
  .txc .tx-lede { color: rgba(255, 255, 255, .72); }
  .txc__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .txc__ticks { list-style: none; padding: 0; margin: 24px 0 0; display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: .92rem; }
  .txc__ticks li { display: inline-flex; align-items: center; gap: 8px; }
  .txc__ticks .tx-ic { width: 18px; height: 18px; color: #7ee2a8; }
  .txc__img { border-radius: var(--tx-r-lg); overflow: hidden; aspect-ratio: 4 / 5; }
  .txc__img img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 899px) { .txc__box { grid-template-columns: 1fr; border-radius: 24px; } .txc__img { aspect-ratio: 16 / 10; order: -1; } .txc__btns .tx-btn { flex: 1 1 220px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "TX call to action",
  "tag": "div",
  "class": "section-tx-cta",
  "settings": [
    { "type": "text", "id": "phone", "label": "Phone", "default": "0469 717 535" },
    { "type": "text", "id": "quote_url", "label": "Quote page (no-JavaScript fallback)", "default": "/pages/furniture-pickup-delivery-sydney" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ready when you are" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get it moved today." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Call us, or get an instant quote in about a minute." },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "image_alt", "label": "Photo alt text", "default": "Titan Express movers carrying a wrapped mattress into a home" }
  ],
  "presets": [{ "name": "TX call to action" }]
}
{% endschema %}
