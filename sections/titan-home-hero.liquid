            <path class="tho-ill__sofa" d="M58 92h92" stroke="rgba(255,255,255,.5)" stroke-width="2" stroke-dasharray="4 6"/>
            <g fill="#0b5cff"><circle cx="40" cy="70" r="9"/><rect x="31" y="80" width="18" height="34" rx="7"/></g>
            <g fill="#071a3d"><rect x="32" y="112" width="6" height="34" rx="3"/><rect x="42" y="112" width="6" height="34" rx="3"/></g>
