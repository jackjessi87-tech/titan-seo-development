          <li><a class="tho-job" href="/pages/couch-delivery-sydney"><span class="tho-job__ic">{{ j_sofa }}</span><span class="tho-job__t">Couch &amp; sofa</span>{{ i_thin }}</a></li>
          <li><a class="tho-job" href="/pages/facebook-marketplace-pickup-delivery-sydney"><span class="tho-job__ic">{{ j_tag }}</span><span class="tho-job__t">Marketplace pickup</span>{{ i_thin }}</a></li>
          <li><a class="tho-job" href="/pages/ikea-pickup-delivery-sydney"><span class="tho-job__ic">{{ j_store }}</span><span class="tho-job__t">IKEA &amp; Bunnings</span>{{ i_thin }}</a></li>
          <li><a class="tho-job" href="/pages/single-item-delivery-sydney"><span class="tho-job__ic">{{ j_box }}</span><span class="tho-job__t">Single item</span>{{ i_thin }}</a></li>
          <li><a class="tho-job" href="/pages/fridge-washing-machine-delivery-sydney"><span class="tho-job__ic">{{ j_fridge }}</span><span class="tho-job__t">Fridge &amp; washer</span>{{ i_thin }}</a></li>
          <li><a class="tho-job" href="/pages/bed-mattress-delivery-sydney"><span class="tho-job__ic">{{ j_bed }}</span><span class="tho-job__t">Bed &amp; mattress</span>{{ i_thin }}</a></li>
          <li><a class="tho-job" href="/pages/man-with-a-van-sydney"><span class="tho-job__ic">{{ j_truck }}</span><span class="tho-job__t">Van &amp; mini truck</span>{{ i_thin }}</a></li>
          <li><a class="tho-job" href="/pages/small-removals-sydney"><span class="tho-job__ic">{{ j_home }}</span><span class="tho-job__t">Home &amp; unit moves</span>{{ i_thin }}</a></li>
