    { "type": "text", "id": "quote_anchor", "label": "Quote button link", "default": "#instant-quote" },
    { "type": "range", "id": "open_hour", "label": "Open from (hour)", "min": 0, "max": 23, "step": 1, "default": 7 },
    { "type": "range", "id": "close_hour", "label": "Open until (hour)", "min": 1, "max": 24, "step": 1, "default": 19 },
    { "type": "text", "id": "live_open", "label": "Status during hours", "default": "Taking same-day bookings now" },
    { "type": "text", "id": "live_closed", "label": "Status after hours", "default": "Book now for tomorrow from 7am" },
    { "type": "text", "id": "live_fallback", "label": "Status without JavaScript", "default": "Same-day pickups available" },
    { "type": "inline_richtext", "id": "heading", "label": "H1 (italic shows in red)", "default": "Same-Day Furniture Pickup &amp; Delivery in <em>Sydney</em>" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "image_alt", "label": "Photo alt text" },
    { "type": "text", "id": "badge_title", "label": "Route card title" },
    { "type": "text", "id": "badge_text", "label": "Route card text" }
  ],
  "blocks": [
    { "type": "chip", "name": "Service link", "settings": [
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "text", "id": "url", "label": "Link" }
    ]}
  ],
  "presets": [{ "name": "Titan home hero" }]
}
{% endschema %}
