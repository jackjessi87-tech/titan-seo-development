<div class="tho" id="tho-{{ section.id }}">
  <div class="tho-bar">
    <div class="tho-wrap tho-bar__in">
      <a class="tho-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
        {%- if settings.logo -%}
          {%- assign logo_w = settings.logo.aspect_ratio | times: 44 | round -%}
          {{ settings.logo | image_url: width: 360 | image_tag: alt: 'Titan Express furniture pickup and delivery Sydney', height: 44, width: logo_w, loading: 'eager' }}
        {%- else -%}<span>Titan Express</span>{%- endif -%}
      </a>
      <nav class="tho-nav" aria-label="Main">
        <a href="/pages/furniture-pickup-delivery-sydney">Pickup &amp; Delivery</a>
        <a href="/pages/single-item-delivery-sydney">Single Item</a>
        <a href="/pages/facebook-marketplace-pickup-delivery-sydney">Marketplace</a>
        <a href="/pages/ikea-pickup-delivery-sydney">Store Collection</a>
        <a href="/pages/areas-we-serve">Areas</a>
      </nav>
      <a class="tho-hcall" href="tel:{{ phone_intl }}">{{ i_phone }}<span>Call for delivery</span></a>
    </div>
  </div>

  <section class="tho-hero">
    <svg class="tho-art" viewBox="0 0 1200 640" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <pattern id="tho-topo-{{ section.id }}" width="160" height="160" patternUnits="userSpaceOnUse">
          <path d="M0 40 C40 20 80 60 160 40 M0 80 C50 60 90 100 160 80 M0 120 C40 100 100 140 160 120" stroke="rgba(255,255,255,.06)" stroke-width="1.2" fill="none"/>
        </pattern>
        <radialGradient id="tho-glow-{{ section.id }}" cx="85%" cy="10%" r="60%">
          <stop offset="0" stop-color="#2f7bff" stop-opacity=".55"/><stop offset="1" stop-color="#2f7bff" stop-opacity="0"/>
        </radialGradient>
      </defs>
      <rect width="1200" height="640" fill="url(#tho-topo-{{ section.id }})"/>
      <rect width="1200" height="640" fill="url(#tho-glow-{{ section.id }})"/>
      <g class="tho-art__rings" fill="none" stroke="rgba(143,180,255,.35)" stroke-width="1.5">
        <circle cx="1080" cy="90" r="40"/><circle cx="1080" cy="90" r="80"/><circle cx="1080" cy="90" r="120"/>
      </g>
      <path class="tho-art__route" d="M-20 560 C 200 460, 320 600, 520 500 S 860 360, 1080 90" fill="none" stroke="rgba(255,255,255,.22)" stroke-width="2.5" stroke-dasharray="2 14" stroke-linecap="round"/>
      <path class="tho-art__run" d="M-20 560 C 200 460, 320 600, 520 500 S 860 360, 1080 90" fill="none" stroke="#8fb4ff" stroke-width="3" stroke-linecap="round" pathLength="100"/>
      <g fill="#8fb4ff"><circle cx="520" cy="500" r="6"/><circle cx="1080" cy="90" r="8"/></g>
      <g fill="none" stroke="rgba(255,255,255,.14)" stroke-width="1.5"><path d="M60 120h40M80 100v40M980 520h30M995 505v30M640 80h24M652 68v24"/></g>
    </svg>
    <div class="tho-wrap tho-hero__grid tho-hero__grid--quote">
      <div class="tho-copy">
        <p class="tho-kicker"><i></i>Sydney removalist team &middot; 7 days</p>
        <h1 class="tho-h1">Sydney Removalists &amp; <em>Same-Day</em> Furniture Pickup &amp; Delivery</h1>
        <p class="tho-sub">Your local removalist team for furniture, appliances and home moves across Sydney. <strong>Two or three movers with a truck</strong> for heavy items, stairs and full moves, or <strong>one man with a mini truck or van</strong> for single items. Fixed price before we start, often today.</p>
      </div>
      <div class="tho-topcall">{{ callbtn | replace: '%%LBL%%', 'Call now &middot; fixed price on the phone' }}</div>
      <div class="thq tho-quote" id="instant-quote">
        {%- render 'titan-home-quote-card', phone: s.phone, phone_intl: phone_intl, uid: section.id -%}
      </div>
      <div class="tho-more">
        {{ callbtn | replace: '%%LBL%%', 'Call your Sydney removalist team' }}
        <div class="tho-ctas2">
          <a class="tho-qbtn tho-qbtn--ghost" href="#tho-crew">{{ i_team }}<span>Compare crews and trucks</span></a>
        </div>
        <p class="tho-for">Couches &middot; beds &middot; fridges &middot; Marketplace &amp; IKEA pickups &middot; apartment and house moves</p>
        <ul class="tho-proof">
          <li><span class="tho-stars">{{ i_star }}{{ i_star }}{{ i_star }}{{ i_star }}{{ i_star }}</span><strong>5.0</strong>&nbsp;&middot; 59 Google reviews</li>
          <li>{{ i_check }}Fully insured</li>
          <li>{{ i_check }}7 days</li>
        </ul>
      </div>
    </div>
  </section>

  <div class="tho-ticker" aria-hidden="true"><div>
    {%- for i in (1..2) -%}
      <span>{{ i_phone }}CALL {{ s.phone }} FOR FURNITURE PICKUP &amp; DELIVERY</span><span>REMOVALISTS &amp; TRUCKS</span><span>MARKETPLACE &amp; IKEA PICKUPS</span><span>SAME-DAY PICKUP</span><span>FIXED PRICE ON THE PHONE</span><span>2 OR 3 MOVERS + TRUCK</span><span>7 DAYS</span>
    {%- endfor -%}
  </div></div>

  {%- render 'titan-travels-showcase', uid: section.id -%}

  <section class="tho-sec tho-crew" id="tho-crew">
    <div class="tho-wrap">
      <p class="tho-eyebrow">Choose your crew</p>
