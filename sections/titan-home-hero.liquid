            <li>{{ i_check }}Sofas, fridges, wardrobes and full rooms</li>
            <li>{{ i_check }}Stairs, lifts and narrow hallways handled</li>
            <li>{{ i_check }}Blankets, straps and trolleys included</li>
            <li>{{ i_check }}You don't lift a thing</li>
          </ul>
          <div class="tho-card__foot">
            <span class="tho-card__price">Fixed price<small>quoted in minutes</small></span>
            <a class="tho-qbtn" href="{{ s.quote_anchor | default: '#instant-quote' }}" data-crew="Two men and truck">{{ i_bolt }}<span>Quote two movers</span></a>
