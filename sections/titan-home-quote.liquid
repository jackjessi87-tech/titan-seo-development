{%- doc -%}
  Titan Express quote band and quote styles. The form itself is snippets/titan-home-quote-card.liquid, rendered in the homepage hero. Was: all-in-one quote (rebuilt 2026-11-17). Tap-to-pick crew, items, access and timing,
  type two suburbs, then name and number. A live summary card shows the job as it is built.
  Uses Shopify's contact form, so requests arrive in the store inbox. Without JavaScript every field
  still shows and the form still submits.
{%- enddoc -%}

{%- liquid
  assign s = section.settings
  assign phone_digits = s.phone | remove: ' '
  assign phone_intl = phone_digits | remove_first: '0' | prepend: '+61'
  assign uid = section.id
  assign sms_body = 'Hi Titan Express, I would like a quote. ' | url_encode | replace: '+', '%20'
  assign sms = 'sms:' | append: phone_intl | append: '?&body=' | append: sms_body
-%}

<section class="thq thq--band" id="quote-ways" aria-labelledby="thq-h-{{ uid }}">
  <div class="thq-wrap">
    <div class="thq-copy">
      <p class="thq-eyebrow"><span class="thq-dot"></span>{{ s.eyebrow | default: 'Instant quote' }}</p>
      <h2 id="thq-h-{{ uid }}" class="thq-h2">Your fixed price in 60 seconds</h2>
      <p class="thq-sub">Call, text us a photo, or use the quick form at the top of the page. Fixed price before we start, no hourly meter, no obligation.</p>
      <div class="thq-ways" role="list">
        <a role="listitem" class="thq-way" href="tel:{{ phone_intl }}"><span class="thq-way__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg></span><span><strong>Call</strong><small>{{ s.phone }}</small></span></a>
        <a role="listitem" class="thq-way" href="{{ sms }}"><span class="thq-way__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.9A8 8 0 1 1 21 12z"/></svg></span><span><strong>Text</strong><small>Send a photo</small></span></a>
        <a role="listitem" class="thq-way is-on" href="#instant-quote"><span class="thq-way__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg></span><span><strong>Quick form</strong><small>60 seconds</small></span></a>
      </div>
    </div>
  </div>
</section>


{% stylesheet %}
  .thq { --thq-b:#0b5cff; --thq-b2:#2f7bff; --thq-ink:#071a3d; --thq-muted:#5a6782; --thq-line:#dfe6f3; --thq-soft:#f5f8ff; --thq-g:#16a34a;
    --thq-grad:linear-gradient(135deg,var(--thq-b2) 0%,var(--thq-b) 100%);
    font-family: Inter, var(--font-body--family, sans-serif); padding:64px 0; color:var(--thq-ink); scroll-margin-top:12px;
    background:radial-gradient(800px 360px at 0% 0%, rgba(47,123,255,.12), transparent 60%), linear-gradient(180deg,#fff 0%,var(--thq-soft) 100%); }
  .thq svg { fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
  .thq-wrap { max-width:1180px; margin:0 auto; padding:0 20px; }
  .thq-grid { display:grid; grid-template-columns:.9fr 1.1fr; gap:44px; align-items:start; }
  .thq-eyebrow { display:inline-flex; align-items:center; gap:8px; margin:0 0 10px; font-size:.78rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; color:var(--thq-b); }
  .thq-dot { width:8px; height:8px; border-radius:50%; background:#22c55e; animation:thq-pulse 2s infinite; }
  @keyframes thq-pulse { 0% { box-shadow:0 0 0 0 rgba(34,197,94,.6); } 70% { box-shadow:0 0 0 9px rgba(34,197,94,0); } 100% { box-shadow:0 0 0 0 rgba(34,197,94,0); } }
  .thq-h2 { margin:0 0 12px; font-size:clamp(1.7rem,3.4vw,2.6rem); line-height:1.1; font-weight:900; letter-spacing:-.015em; }
  .thq-sub { margin:0 0 20px; font-size:1.05rem; line-height:1.5; color:var(--thq-muted); }
  .thq-ways { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-bottom:18px; }
  .thq-way { display:flex; flex-direction:column; gap:8px; padding:14px; border-radius:16px; background:#fff; border:1.5px solid var(--thq-line); color:var(--thq-ink); text-decoration:none; transition:transform .2s, border-color .2s, box-shadow .2s; }
  .thq-way:hover, .thq-way.is-on { border-color:var(--thq-b); box-shadow:0 10px 24px rgba(11,92,255,.14); transform:translateY(-2px); }
  .thq-way strong { display:block; font-weight:900; } .thq-way small { color:var(--thq-muted); font-size:.78rem; font-weight:600; }
  .thq-way__ic { display:grid; place-items:center; width:38px; height:38px; border-radius:12px; background:var(--thq-grad); color:#fff; }
  .thq-way__ic svg { width:20px; height:20px; }
  .thq-way.is-on .thq-way__ic { background:linear-gradient(135deg,#22c55e,#16a34a); }
  .thq-way.is-on .thq-way__ic svg { fill:currentColor; stroke:none; }
  .thq-live { padding:18px; border-radius:20px; background:linear-gradient(160deg,#0a2a63,#071a3d); color:#fff; box-shadow:0 20px 44px rgba(7,26,61,.3); }
  .thq-live__t { margin:0 0 10px; font-size:.75rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; color:#8fb4ff; }
  .thq-live ul { list-style:none; padding:0; margin:0; display:grid; gap:8px; }
  .thq-live li { display:flex; justify-content:space-between; gap:12px; padding-bottom:8px; border-bottom:1px dashed rgba(255,255,255,.14); font-size:.9rem; }
  .thq-live li span { color:#a9c3f5; } .thq-live li b { text-align:right; font-weight:700; }
  .thq-live__p { margin:12px 0 0; padding:10px 12px; border-radius:12px; background:rgba(34,197,94,.16); color:#bbf7d0; font-weight:700; font-size:.88rem; }
  .thq-card { position:relative; background:#fff; border-radius:24px; padding:26px; box-shadow:0 30px 70px rgba(11,40,99,.14), 0 0 0 1px var(--thq-line); scroll-margin-top:12px; }
  .thq-card::before { content:""; position:absolute; inset:-2px; border-radius:26px; padding:2px; background:var(--thq-grad); -webkit-mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite:xor; mask-composite:exclude; opacity:.6; pointer-events:none; }
  .thq-progress { height:6px; border-radius:99px; background:var(--thq-soft); overflow:hidden; margin-bottom:16px; }
  .thq-progress__bar { height:100%; width:50%; background:linear-gradient(90deg,#22c55e,var(--thq-b)); border-radius:99px; transition:width .35s ease; }
  .thq-step { border:0; padding:0; margin:0; min-width:0; }
  .thq-card.is-js .thq-step { display:none; }
  .thq-card.is-js .thq-step.is-active { display:block; animation:thq-in .3s ease; }
  .thq-card:not(.is-js) .thq-progress, .thq-card:not(.is-js) [data-next], .thq-card:not(.is-js) [data-back], .thq-card:not(.is-js) .thq-chips { display:none; }
  @keyframes thq-in { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:none; } }
  .thq-legend { display:flex; align-items:center; gap:10px; padding:0; margin:0 0 14px; font-size:1.2rem; font-weight:900; }
  .thq-n { display:grid; place-items:center; width:28px; height:28px; border-radius:50%; background:var(--thq-grad); color:#fff; font-size:.85rem; }
  .thq-label { margin:14px 0 8px; font-size:.86rem; font-weight:800; }
  .thq-label small { font-weight:600; color:var(--thq-muted); }
  .thq-seg { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
  .thq-seg label { position:relative; display:block; cursor:pointer; }
  .thq-seg span { box-sizing:border-box; width:100%; }
  .thq-seg input { position:absolute; opacity:0; pointer-events:none; }
  .thq-seg span { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px; height:100%; min-height:46px; padding:10px 8px; border-radius:14px; border:1.5px solid var(--thq-line); background:#fff; text-align:center; transition:border-color .15s, background .15s, box-shadow .15s; }
  .thq-seg span svg { width:24px; height:24px; color:var(--thq-b); }
  .thq-seg b { font-size:.86rem; line-height:1.2; } .thq-seg small { font-size:.72rem; color:var(--thq-muted); font-weight:600; }
  .thq-seg input:checked + span { border-color:var(--thq-b); background:#eef4ff; box-shadow:0 0 0 3px rgba(11,92,255,.12); }
  .thq-seg input:focus-visible + span { outline:2px solid var(--thq-b); outline-offset:2px; }
  .thq-seg--sm { grid-template-columns:repeat(auto-fit, minmax(92px, 1fr)); }
  .thq-types { display:grid; grid-template-columns:repeat(2,1fr); gap:8px; }
  .thq-types label { position:relative; display:block; cursor:pointer; }
  .thq-types input { position:absolute; opacity:0; pointer-events:none; }
  .thq-types span { box-sizing:border-box; width:100%; height:100%; display:grid; grid-template-columns:auto 1fr; grid-template-rows:auto auto; column-gap:10px; align-items:center; padding:12px; border-radius:16px; border:1.5px solid var(--thq-line); background:#fff; transition:all .15s; }
  .thq-types svg { grid-row:1 / span 2; width:36px; height:36px; padding:7px; box-sizing:border-box; border-radius:12px; background:#eef4ff; color:var(--thq-b); }
  .thq-types b { font-size:.9rem; line-height:1.2; } .thq-types small { font-size:.74rem; color:var(--thq-muted); font-weight:600; }
  .thq-types input:checked + span { border-color:var(--thq-b); background:#eef4ff; box-shadow:0 0 0 3px rgba(11,92,255,.12); }
  .thq-types input:checked + span svg { background:var(--thq-grad); color:#fff; }
  .thq-types input:focus-visible + span { outline:2px solid var(--thq-b); outline-offset:2px; }
  .thq-beds { display:none; } .thq-card.is-house .thq-beds, .thq-card:not(.is-js) .thq-beds { display:block; }
  .thq-smart { margin-top:14px; }
  .thq-smart__lbl { display:block; margin:0 0 8px; font-size:.95rem; font-weight:900; }
  .thq-smart__box { position:relative; border-radius:18px; padding:2px; background:linear-gradient(135deg,#2f7bff,#22c55e,#0b5cff); background-size:200% 200%; animation:thq-glow 6s ease infinite; }
  @keyframes thq-glow { 0%,100% { background-position:0% 50%; } 50% { background-position:100% 50%; } }
  .thq-smart__box textarea { display:block; width:100%; box-sizing:border-box; min-height:104px; padding:16px 16px 16px 46px; border:0; border-radius:16px; background:#fff; font:inherit; font-size:16px; line-height:1.5; color:var(--thq-ink); resize:vertical; }
  .thq-smart__box textarea:focus { outline:none; box-shadow:0 0 0 4px rgba(11,92,255,.15); }
  .thq-smart__ic { position:absolute; left:16px; top:18px; width:20px; height:20px; color:var(--thq-b); z-index:1; pointer-events:none; }
  .thq-smart__ph { position:absolute; left:48px; right:16px; top:18px; color:#8a97b3; font-size:16px; line-height:1.5; pointer-events:none; }
  .thq-smart__ph::after { content:""; display:inline-block; width:2px; height:1.1em; margin-left:2px; vertical-align:-2px; background:var(--thq-b); animation:thq-caret 1s steps(1) infinite; }
  .thq-smart__ph:empty::after { display:none; }
  @keyframes thq-caret { 50% { opacity:0; } }
  .thq-smart__tip { margin:8px 2px 0; font-size:.82rem; color:var(--thq-muted); font-weight:600; }
  .thq-smart__tip.is-on { color:var(--thq-g); }
  .thq-smart__tip b { color:var(--thq-ink); }
  .thq-chips { display:flex; flex-wrap:wrap; gap:8px; }
  .thq-chips[hidden] { display:none; }
  html.thq-in-view .tho-callbar, html.thq-in-view .tho-msg { opacity:0; visibility:hidden; transform:translateY(16px); pointer-events:none; }
  .tho-callbar, .tho-msg { transition:opacity .25s, transform .25s, visibility .25s; }
  .thq-chip { padding:9px 14px; border-radius:999px; border:1.5px solid var(--thq-line); background:#fff; color:var(--thq-ink); font:inherit; font-weight:700; font-size:.86rem; cursor:pointer; transition:all .15s; }
  .thq-chip[aria-pressed="true"] { background:var(--thq-b); border-color:var(--thq-b); color:#fff; box-shadow:0 6px 14px rgba(11,92,255,.25); }
  .thq-chip[aria-pressed="true"]::before { content:"✓ "; }
  .thq-row { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:14px; }
  .thq-field { display:block; margin:0 0 12px; }
  .thq-field > span { display:block; margin:0 0 6px; font-size:.86rem; font-weight:800; }
  .thq-field small { font-weight:600; color:var(--thq-muted); }
  .thq-field input, .thq-field textarea, .thq-field select { width:100%; box-sizing:border-box; min-height:48px; padding:12px 14px; border-radius:12px; border:1.5px solid var(--thq-line); background:#fff; font:inherit; font-size:16px; color:var(--thq-ink); }
  .thq-field textarea { resize:vertical; min-height:56px; }
  .thq-field input:focus, .thq-field textarea:focus { outline:none; border-color:var(--thq-b); box-shadow:0 0 0 3px rgba(11,92,255,.12); }
  .thq-card.is-js .thq-date { display:none; margin-top:10px; } .thq-card.is-js.show-date .thq-date { display:block; }
  .thq-step > .thq-field:last-of-type { margin-top:14px; }
  .thq-btn { display:inline-flex; align-items:center; justify-content:center; gap:8px; min-height:54px; padding:0 24px; border-radius:999px; border:0; font:inherit; font-weight:900; font-size:1rem; cursor:pointer; transition:transform .2s, box-shadow .2s; }
  .thq-btn:hover { transform:translateY(-1px); }
  .thq-btn--primary { width:100%; background:linear-gradient(135deg,#22c55e,#16a34a); color:#fff; box-shadow:0 12px 28px rgba(22,163,74,.35); }
  .thq-btn--ghost { background:var(--thq-soft); color:var(--thq-ink); }
  .thq-nav { display:grid; grid-template-columns:auto 1fr; gap:10px; }
  .thq-fine { display:flex; align-items:center; justify-content:center; gap:6px; margin:14px 0 0; font-size:.82rem; color:var(--thq-muted); font-weight:600; }
  .thq-fine svg { width:16px; height:16px; color:var(--thq-g); }
  .thq-error { margin:0 0 12px; padding:12px 14px; border-radius:12px; background:#fee2e2; color:#9f1239; }
  .thq-done { text-align:center; padding:24px 8px; }
  .thq-done__icon { width:64px; height:64px; margin:0 auto 14px; border-radius:50%; background:linear-gradient(135deg,#22c55e,#16a34a); color:#fff; font-size:2rem; display:grid; place-items:center; }
  .thq-done h3 { margin:0 0 8px; } .thq-done a { color:var(--thq-b); font-weight:800; }
  @media (max-width: 900px) {
    .thq { padding:40px 0; }
    .thq-wrap { padding:0 16px; }
    .thq-grid { grid-template-columns:1fr; gap:20px; }
    .thq-card { padding:18px; order:2; }
    .thq-live { display:none; }
  }
  @media (max-width: 480px) {
    .thq-row { grid-template-columns:1fr; }
    .thq-seg--crew { grid-template-columns:1fr; }
    .thq-seg--crew span { flex-direction:row; justify-content:flex-start; text-align:left; gap:10px; }
    .thq-seg--crew small { margin-left:auto; }
  }
  @media (prefers-reduced-motion: reduce) { .thq *, .thq *::before { animation:none !important; transition:none !important; } }
  /* Photo merged into the top of the quote card (2026-11-20) */
  .thq-photo { position:relative; height:200px; margin:-26px -26px 18px; border-radius:24px 24px 0 0; overflow:hidden; background:#071a3d; }
  .thq-photo img { display:block; width:100%; height:100%; object-fit:cover; object-position:center 42%; }
  .thq-photo::after { content:""; position:absolute; inset:auto 0 0 0; height:44%; background:linear-gradient(180deg, transparent, rgba(7,26,61,.78)); }
  .thq-photo__t { position:absolute; z-index:1; left:20px; right:20px; bottom:14px; display:flex; align-items:center; gap:8px; color:#fff; font-weight:900; font-size:1.3rem; letter-spacing:-.01em; text-shadow:0 2px 10px rgba(0,0,0,.5); }
  .thq-photo__t svg { width:22px; height:22px; fill:none; stroke:#4ade80; stroke-width:2.2; stroke-linecap:round; stroke-linejoin:round; }
  .thq-photo__tag { position:absolute; z-index:1; top:12px; left:12px; display:flex; align-items:center; gap:7px; padding:6px 11px; border-radius:999px; background:rgba(255,255,255,.95); color:#071a3d; font-size:.76rem; font-weight:800; }
  .thq-photo__tag i { width:8px; height:8px; border-radius:50%; background:#22c55e; }
  @media (max-width: 899px) { .thq-photo { height:200px; margin:-18px -18px 14px; } .thq-photo__t { left:16px; font-size:1.15rem; } }
  /* The form now lives in the homepage hero; this section is a short call, text or form band (2026-11-20) */
  .thq--band { padding:52px 0; }
  .thq--band .thq-copy { max-width:720px; margin:0 auto; text-align:center; }
  .thq--band .thq-ways { max-width:560px; margin:0 auto; text-align:left; }
  .thq-nav .thq-btn[data-next] { flex:1 1 auto; }
  /* 2026-11-27 smoother quote steps: the step lands on screen, compact crew choice on phones, photo prompt after sending */
  .thq-progress { scroll-margin-top:14px; }
  .thq-smart__tip.is-err { color:#b91c1c; }
  @media (max-width: 899px) {
    .thq-seg.thq-seg--crew { grid-template-columns:repeat(2, 1fr); }
    .thq-seg.thq-seg--crew span { flex-direction:column; align-items:flex-start; justify-content:center; text-align:left; gap:2px; min-height:62px; padding:9px 11px; }
    .thq-seg.thq-seg--crew span svg { display:none; }
    .thq-seg.thq-seg--crew small { margin-left:0; }
  }
  .thq-done .thq-done__photo { display:flex; align-items:center; gap:12px; margin-top:16px; padding:12px 14px; border-radius:14px; border:1.5px solid #bfd3ff; background:#eef4ff; color:var(--thq-ink); text-align:left; text-decoration:none; }
  .thq-done__photo svg { flex:none; width:28px; height:28px; color:var(--thq-b); }
  .thq-done__photo span { display:grid; gap:2px; line-height:1.25; }
  .thq-done__photo b { font-size:.98rem; font-weight:800; }
  .thq-done__photo small { font-size:.8rem; font-weight:600; color:var(--thq-muted); }
{% endstylesheet %}

{% schema %}
{
  "name": "Titan home quote",
  "tag": "div",
  "class": "section-titan-home-quote",
  "settings": [
    { "type": "text", "id": "phone", "label": "Phone", "default": "0469 717 535" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Instant quote" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get Your Fixed Price in 60 Seconds" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" }
  ],
  "presets": [{ "name": "Titan home quote" }]
}
{% endschema %}
