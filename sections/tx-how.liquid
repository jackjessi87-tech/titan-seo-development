{%- comment -%} Titan Express redesign: how it works (3 steps) and the crew choice (1 mover + van, customer helps; or 2 movers). {%- endcomment -%}
<section id="tx-how" class="tx tx-band tx-band--grey txw" aria-labelledby="txw-h-{{ section.id }}">
  <div class="tx-wrap">
    <div class="tx-head tx-head--center">
      <p class="tx-eyebrow tx-reveal">{{ section.settings.eyebrow }}</p>
      <h2 class="tx-h2 tx-reveal" id="txw-h-{{ section.id }}" style="--d:.05s">{{ section.settings.heading }}</h2>
      <p class="tx-lede tx-reveal" style="--d:.1s">{{ section.settings.text }}</p>
    </div>
    <ol class="txw__steps" role="list">
      {%- assign icons = 'route,camera,van' | split: ',' -%}
      {%- for i in (1..3) -%}
        {%- capture t %}step_{{ i }}_title{% endcapture -%}{%- capture d %}step_{{ i }}_text{% endcapture -%}
        <li class="txw__step tx-reveal" style="--d:{{ i | times: 0.08 }}s">
          <span class="txw__num">0{{ i }}</span>
          <span class="tx-ic-tile">{% render 'tx-icon', name: icons[forloop.index0] %}</span>
          <h3 class="tx-h3">{{ section.settings[t] }}</h3>
          <p>{{ section.settings[d] }}</p>
        </li>
      {%- endfor -%}
    </ol>

    <div class="txw__crew tx-reveal">
      <div class="txw__crewhead">
        <h3 class="tx-h3">{{ section.settings.crew_heading }}</h3>
        <p>{{ section.settings.crew_text }}</p>
      </div>
      <div class="txw__opts">
        <div class="txw__opt">
          <svg class="txw__fig" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="17" r="9" class="f s"/><path d="M16 56v-8a16 16 0 0 1 32 0v8z" class="f s"/><rect x="40" y="40" width="16" height="14" rx="2" class="w"/></svg>
          <div><b>{{ section.settings.crew_1_title }}</b><span>{{ section.settings.crew_1_text }}</span><em class="txw__tag">From $99</em></div>
        </div>
        <div class="txw__opt txw__opt--two">
          <svg class="txw__fig" viewBox="0 0 64 64" aria-hidden="true"><circle cx="22" cy="19" r="8" class="f s"/><path d="M8 56v-7a14 14 0 0 1 28 0v7z" class="f s"/><circle cx="44" cy="16" r="8" class="f s"/><path d="M30 56v-9a14 14 0 0 1 28 0v9z" class="a s"/></svg>
          <div><b>{{ section.settings.crew_2_title }}</b><span>{{ section.settings.crew_2_text }}</span><em class="txw__tag txw__tag--red">Extra fee</em></div>
        </div>
      </div>
    </div>
  </div>
</section>
<div id="tx-reviews" class="tx-anchor" aria-hidden="true"></div>

{% stylesheet %}
  .txw__steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; counter-reset: s; position: relative; }
  .txw__steps::before { content: ""; position: absolute; top: 58px; left: 12%; right: 12%; border-top: 2px dashed #cfd6e6; z-index: 0; }
  .txw__step { position: relative; z-index: 1; background: #fff; border: 1px solid var(--tx-line); border-radius: var(--tx-r-lg); padding: 28px 24px; }
  .txw__step p { margin: 8px 0 0; color: var(--tx-muted); font-size: .96rem; }
  .txw__step .tx-h3 { margin-top: 18px; }
  .txw__num { position: absolute; top: 22px; right: 24px; font: 800 2.2rem/1 var(--tx-font-head); color: var(--tx-grey-2); letter-spacing: -.04em; }
  .txw__step .tx-ic-tile { background: var(--tx-navy); color: #fff; box-shadow: 0 10px 20px rgba(23, 53, 127, .25); }
  .txw__crew { margin-top: 18px; display: grid; grid-template-columns: .9fr 1.1fr; gap: 24px; align-items: center; background: var(--tx-navy-900); color: rgba(255, 255, 255, .78);
    border-radius: var(--tx-r-lg); padding: clamp(24px, 4vw, 40px); position: relative; overflow: hidden; }
  .txw__crew::after { content: ""; position: absolute; right: -120px; top: -120px; width: 320px; height: 320px; border-radius: 50%; background: radial-gradient(closest-side, rgba(225, 38, 28, .35), transparent); }
  .txw__crew .tx-h3 { color: #fff; font-size: 1.5rem; }
  .txw__crewhead p { margin: 10px 0 0; }
  .txw__opts { display: grid; gap: 12px; position: relative; z-index: 1; }
  .txw__opt { display: flex; gap: 16px; align-items: center; background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .12); border-radius: 18px; padding: 14px 16px; }
  .txw__opt b { display: block; color: #fff; font-size: 1.02rem; }
  .txw__opt span { display: block; font-size: .9rem; }
  .txw__fig { width: 56px; height: 56px; flex: none; }
  .txw__fig .f { fill: rgba(255, 255, 255, .14); } .txw__fig .s { stroke: #fff; stroke-width: 2.4; } .txw__fig .w { fill: #fff; } .txw__fig .a { fill: var(--tx-red); }
  .txw__tag { display: inline-block; margin-top: 6px; font-style: normal; font-size: .75rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: #cdd8f5;
    background: rgba(255, 255, 255, .1); border-radius: 999px; padding: 3px 9px; }
  .txw__tag--red { background: rgba(225, 38, 28, .22); color: #ffb3ae; }
  @media (max-width: 899px) {
    .txw__steps { grid-template-columns: 1fr; }
    .txw__steps::before { top: 30px; bottom: 30px; left: 50px; right: auto; border-top: 0; border-left: 2px dashed #cfd6e6; }
    .txw__crew { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TX how it works",
  "tag": "div",
  "class": "section-tx-how",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Booked in about a minute" },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "Simple hourly rates and no surprises. You see an estimate before you book." },
    { "type": "text", "id": "step_1_title", "label": "Step 1 title", "default": "Tell us the route" },
    { "type": "textarea", "id": "step_1_text", "label": "Step 1 text", "default": "Pickup and drop-off, and what needs moving. Tap your items, it takes about a minute." },
    { "type": "text", "id": "step_2_title", "label": "Step 2 title", "default": "See your estimate" },
    { "type": "textarea", "id": "step_2_text", "label": "Step 2 text", "default": "$99 covers the first 30 minutes, then $52 for each extra 30 minutes. We text to confirm your time." },
    { "type": "text", "id": "step_3_title", "label": "Step 3 title", "default": "We pick up and deliver" },
    { "type": "textarea", "id": "step_3_text", "label": "Step 3 text", "default": "Wrapped in blankets, strapped in the van and carried in, often the same day." },
    { "type": "text", "id": "crew_heading", "label": "Crew heading", "default": "Choose your crew" },
    { "type": "textarea", "id": "crew_text", "label": "Crew text", "default": "Most single items need one mover and a big van, with a hand from you at each end. Prefer not to lift? Add a second mover." },
    { "type": "text", "id": "crew_1_title", "label": "Option 1 title", "default": "1 mover + big van" },
    { "type": "text", "id": "crew_1_text", "label": "Option 1 text", "default": "You help load and unload the heavy items." },
    { "type": "text", "id": "crew_2_title", "label": "Option 2 title", "default": "2 movers + big van" },
    { "type": "text", "id": "crew_2_text", "label": "Option 2 text", "default": "We do all the lifting, wrapping and carrying." }
  ],
  "presets": [{ "name": "TX how it works" }]
}
{% endschema %}
