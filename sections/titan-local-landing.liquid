{%- doc -%}
  Titan Express local landing page (one suburb or area).
  Reusable: every suburb page is a new JSON template with this one section and
  its own settings and blocks. Built with HTML, CSS and Liquid; the small script
  at the end only adds the live Sydney-time status and the step-by-step quote
  form. Without JavaScript the form shows all fields and still submits.
  Quote requests use Shopify's contact form, so they arrive in the store's
  contact inbox like the other quote forms.
  Schema output: Service, WebPage, BreadcrumbList, FAQPage only.
{%- enddoc -%}

{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign phone_digits = s.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-'
  assign phone_intl = phone_digits | remove_first: '0' | prepend: '+61'
  assign nearby = s.nearby_suburbs | split: ','
  assign intents = section.blocks | where: 'type', 'intent'
  assign local_points = section.blocks | where: 'type', 'local_point'
  assign faqs = section.blocks | where: 'type', 'faq'
  assign links = section.blocks | where: 'type', 'link'
  assign compare_rows = section.blocks | where: 'type', 'compare_row'
  assign form_id = 'LocalQuote-' | append: uid
-%}


{%- liquid
  assign pg = template.suffix | default: page.handle | default: ''
  case pg
    when 'bed-mattress-delivery-sydney'
      assign svc = 'bed & mattress delivery'
    when 'bunnings-store-collection-sydney'
      assign svc = 'Bunnings & store collection'
    when 'fridge-washing-machine-delivery-sydney'
      assign svc = 'fridge & washer delivery'
    when 'fridge-movers-sydney'
      assign svc = 'fridge movers'
    when 'furniture-pickup-delivery-sydney'
      assign svc = 'furniture pickup & delivery'
    when 'gumtree-pickup-delivery-sydney'
      assign svc = 'Gumtree pickup & delivery'
    when 'ikea-pickup-delivery-sydney'
      assign svc = 'IKEA pickup & delivery'
    when 'man-with-a-van'
      assign svc = 'man and van Sydney'
    when 'same-day-removalists-sydney'
      assign svc = 'same-day removals'
    when 'single-item-delivery-sydney'
      assign svc = 'single item delivery'
    when 'small-removals-sydney'
      assign svc = 'small removals'
    when 'couch-delivery'
      assign svc = 'couch delivery'
    when 'marketplace-pickup-delivery'
      assign svc = 'Marketplace pickup'
    when 'washing-machine-delivery-sydney'
      assign svc = 'washing machine delivery'
    when 'furniture-courier-sydney'
      assign svc = 'a furniture courier'
    when 'van-and-driver-hire-sydney'
      assign svc = 'van and driver hire'
    when 'two-men-and-a-van-sydney'
      assign svc = 'two men and a van'
    when 'dining-table-delivery-sydney'
      assign svc = 'table delivery'
    when 'wardrobe-delivery-sydney'
      assign svc = 'wardrobe delivery'
    when 'furniture-store-delivery-sydney'
      assign svc = 'furniture store delivery'
    when 'student-removals-sydney'
      assign svc = 'a student move'
    else
      if pg contains 'man-and-van'
        assign svc = 'man and van ' | append: s.suburb_name
      elsif pg contains 'removalists'
        assign svc = 'removals in ' | append: s.suburb_name
      else
        assign svc = s.service_type | split: ',' | first | downcase
      endif
  endcase
  assign svc_esc = svc | escape
-%}
{%- capture icon_thin -%}<svg class="tll-thin" viewBox="0 0 30 14" aria-hidden="true"><path d="M1 7h27M22 1l6 6-6 6"/></svg>{%- endcapture -%}
{%- capture dial -%}{%- assign chars = s.phone | split: '' -%}{%- for c in chars -%}{%- if c == ' ' -%}&nbsp;{%- else -%}<span style="animation-delay:{{ forloop.index0 | times: 0.09 }}s">{{ c }}</span>{%- endif -%}{%- endfor -%}{%- endcapture -%}

