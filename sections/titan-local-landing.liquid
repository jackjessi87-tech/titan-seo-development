<script>
  (function () {
    var root = document.getElementById('tll-{{ uid }}');
    if (!root) return;

    /* Live Sydney time and booking status */
    var textEl = root.querySelector('[data-live-text]');
    var timeEl = root.querySelector('[data-live-time]');
    var open = parseInt(root.dataset.openHour, 10) || 8;
    var close = parseInt(root.dataset.closeHour, 10) || 18;
    function tick() {
      try {
        var now = new Date();
        var parts = new Intl.DateTimeFormat('en-AU', { timeZone: 'Australia/Sydney', hour: 'numeric', minute: '2-digit', weekday: 'short', hour12: true }).format(now);
        var hour = parseInt(new Intl.DateTimeFormat('en-AU', { timeZone: 'Australia/Sydney', hour: 'numeric', hour12: false }).format(now), 10);
        timeEl.textContent = 'Sydney ' + parts;
        var live = hour >= open && hour < close;
        root.classList.toggle('is-after-hours', !live);
        textEl.textContent = live ? {{ s.live_open | json }} : {{ s.live_closed | json }};
      } catch (e) {}
    }
    tick();
    setInterval(tick, 30000);

    /* Step-by-step quote form */
    var form = root.querySelector('.tll-form');
    if (!form) return;
    var steps = [].slice.call(form.querySelectorAll('[data-step]'));
    if (!steps.length) return;
    var back = form.querySelector('[data-back]');
    var next = form.querySelector('[data-next]');
    var submit = form.querySelector('[data-submit]');
    var bar = form.querySelector('[data-progress]');
    var label = form.querySelector('[data-step-label]');
    var current = 0;
    form.classList.add('is-stepped');
    function show(i) {
      current = i;
      steps.forEach(function (st, n) { st.hidden = n !== i; });
      back.hidden = i === 0;
      next.hidden = i === steps.length - 1;
      submit.hidden = i !== steps.length - 1;
      if (bar) bar.style.width = ((i + 1) / steps.length * 100) + '%';
      if (label) label.textContent = 'Step ' + (i + 1) + ' of ' + steps.length;
    }
    function valid(st) {
      var fields = [].slice.call(st.querySelectorAll('input, textarea, select'));
      for (var k = 0; k < fields.length; k++) {
        if (!fields[k].checkValidity()) { fields[k].reportValidity(); return false; }
      }
      return true;
    }
    next.addEventListener('click', function () {
      if (valid(steps[current])) { show(current + 1); var f = steps[current].querySelector('input, textarea'); if (f) f.focus(); }
    });
    back.addEventListener('click', function () { show(current - 1); });
    show(0);
  })();
</script>

{% stylesheet %}
  .tll {
    --tll-red: #0b5cff;
    --tll-red-2: #2f7bff;
    --tll-ink: #071a3d;
    --tll-ink-2: #0a2a63;
    --tll-text: rgba(0, 0, 0, 0.82);
    --tll-muted: #5a6782;
    --tll-line: rgba(0, 0, 0, 0.08);
    --tll-soft: #f5f8ff;
    --tll-green: #22c55e;
    --tll-radius: 18px;
    --tll-grad: linear-gradient(135deg, var(--tll-red) 0%, var(--tll-red-2) 100%);
    font-family: Inter, var(--font-body--family, sans-serif);
    color: var(--tll-text);
    background: #fff;
    overflow-x: clip;
  }
  .tll *, .tll *::before, .tll *::after { box-sizing: border-box; }
  .tll svg { width: 1.25em; height: 1.25em; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
  .tll-wrap { width: min(1180px, 100% - 32px); margin-inline: auto; }
  .tll-section { padding-block: clamp(48px, 7vw, 88px); }
  .tll h3 { margin: 0; }

  /* Live strip */
  .tll-live {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: center;
    padding: 9px 16px; background: var(--tll-ink); color: #fff; font-size: 0.875rem; font-weight: 500;
  }
  .tll-live__dot { width: 10px; height: 10px; border-radius: 50%; background: var(--tll-green); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.6); flex-shrink: 0; }
  .tll.is-after-hours .tll-live__dot { background: #f59e0b; }
  .tll-live__time { opacity: 0.65; }
  .tll-live__call { display: inline-flex; align-items: center; gap: 6px; color: #fff; font-weight: 700; text-decoration: none; padding: 4px 12px; border-radius: 999px; background: var(--tll-grad); }

  /* Breadcrumbs */
  .tll-crumbs ol { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 14px 0 0; margin: 0; font-size: 0.85rem; color: var(--tll-muted); }
  .tll-crumbs li + li::before { content: "/"; margin-right: 6px; opacity: 0.5; }
  .tll-crumbs a { color: inherit; }

  /* Hero */
  .tll-hero { position: relative; margin-top: 14px; background: radial-gradient(1200px 500px at 85% -10%, rgba(11, 92, 255, 0.35), transparent 60%), radial-gradient(800px 400px at -10% 110%, rgba(47, 123, 255, 0.18), transparent 60%), var(--tll-ink); color: #fff; overflow: hidden; }
  .tll-hero__grid-bg { position: absolute; inset: 0; pointer-events: none; }
  .tll-hero__inner { position: relative; display: grid; gap: 36px; padding-block: clamp(40px, 7vw, 96px); }
  @media (min-width: 900px) { .tll-hero__inner { grid-template-columns: 1.15fr 0.85fr; align-items: center; } }
  .tll-kicker { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 18px; padding: 6px 14px; border: 1px solid rgba(255, 255, 255, 0.18); border-radius: 999px; background: rgba(255, 255, 255, 0.06); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #a9c3f5; }
  .tll-h1 { margin: 0 0 16px; font-size: clamp(2.5rem, 5vw + 1rem, 4.75rem); line-height: 1.02; font-weight: 800; letter-spacing: -0.03em; text-wrap: balance; }
  .tll-h1 em { font-style: normal; background: var(--tll-grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .tll-hero__sub { margin: 0 0 28px; max-width: 34em; font-size: clamp(1.05rem, 0.4vw + 1rem, 1.25rem); line-height: 1.55; color: rgba(255, 255, 255, 0.78); }
  .tll-hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 26px; }
  .tll-trust { display: flex; flex-wrap: wrap; gap: 8px 18px; list-style: none; margin: 0; padding: 0; font-size: 0.9rem; color: rgba(255, 255, 255, 0.82); }
  .tll-trust li { display: inline-flex; align-items: center; gap: 7px; }
  .tll-trust li:first-child svg { fill: #fbbf24; stroke: #fbbf24; }
  .tll-hero__media { position: relative; }
  .tll-hero__img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; max-height: 560px; object-fit: cover; border-radius: 26px; border: 1px solid rgba(255, 255, 255, 0.12); box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55); }
  .tll-hero__badge { position: absolute; left: 16px; right: 16px; bottom: 16px; display: flex; align-items: center; gap: 12px; padding: 14px 16px; }
  .tll-hero__badge strong { display: block; font-size: 0.95rem; }
  .tll-hero__badge span { font-size: 0.82rem; opacity: 0.8; }
  .tll-glass { background: rgba(7, 26, 61, 0.55); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 16px; backdrop-filter: blur(14px) saturate(140%); -webkit-backdrop-filter: blur(14px) saturate(140%); color: #fff; }

  /* Buttons */
  .tll-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; padding: 12px 22px; border: 0; border-radius: 14px; font: inherit; font-weight: 700; font-size: 1rem; text-decoration: none; cursor: pointer; transition: transform 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease; }
  .tll-btn:hover, .tll-btn:focus-visible { transform: translateY(-2px); }
  .tll-btn:focus-visible, .tll a:focus-visible, .tll summary:focus-visible, .tll input:focus-visible, .tll textarea:focus-visible { outline: 3px solid #a9c3f5; outline-offset: 3px; }
  .tll-btn--call { background: var(--tll-grad); color: #fff; padding-left: 10px; box-shadow: 0 10px 30px rgba(11, 92, 255, 0.4); }
  .tll-btn--call:hover { box-shadow: 0 14px 38px rgba(11, 92, 255, 0.55); }
  .tll-btn__icon { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 10px; background: rgba(255, 255, 255, 0.18); }
  .tll-btn__label { display: flex; flex-direction: column; align-items: flex-start; line-height: 1.15; font-size: 1.15rem; letter-spacing: 0.01em; }
  .tll-btn__label small { font-size: 0.74rem; font-weight: 800; opacity: 0.95; letter-spacing: 0.01em; }
  .tll-btn--ghost { background: rgba(255, 255, 255, 0.08); color: inherit; border: 1px solid rgba(255, 255, 255, 0.22); }
  .tll-quote .tll-btn--ghost, .tll-form .tll-btn--ghost { background: var(--tll-soft); border-color: var(--tll-line); color: var(--tll-ink); }
  .tll-btn--primary { background: var(--tll-grad); color: #fff; box-shadow: 0 10px 26px rgba(11, 92, 255, 0.35); }
  .tll-btn--light { background: #fff; color: var(--tll-ink); }

  /* Headings */
  .tll-eyebrow { margin: 0 0 10px; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--tll-red); }
  .tll-eyebrow--light { color: #a9c3f5; }
  .tll-h2 { margin: 0 0 14px; font-size: clamp(1.75rem, 2.2vw + 1rem, 2.75rem); line-height: 1.1; font-weight: 800; letter-spacing: -0.02em; color: var(--tll-ink); text-wrap: balance; }
  .tll-lead { margin: 0 0 24px; max-width: 46em; color: var(--tll-muted); font-size: 1.05rem; line-height: 1.6; }
  .tll-rte p { margin: 0 0 14px; line-height: 1.7; font-size: 1.05rem; }
  .tll-rte strong { color: var(--tll-ink); background: linear-gradient(transparent 60%, rgba(11, 92, 255, 0.16) 60%); }

  /* Intent cards */
  .tll-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; list-style: none; margin: 28px 0 0; padding: 0; }
  .tll-card { position: relative; display: flex; flex-direction: column; gap: 10px; padding: 24px; border-radius: var(--tll-radius); background: var(--tll-soft); border: 1px solid var(--tll-line); transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease; }
  .tll-card:hover { transform: translateY(-4px); border-color: rgba(11, 92, 255, 0.35); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.08); }
  .tll-card__icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; background: var(--tll-ink); color: #fff; }
  .tll-card__icon svg { width: 24px; height: 24px; }
  .tll-card h3 { font-size: 1.15rem; color: var(--tll-ink); }
  .tll-card p { margin: 0; color: var(--tll-muted); line-height: 1.55; }
  .tll-card__link { margin-top: auto; display: inline-flex; align-items: center; gap: 6px; font-weight: 700; color: var(--tll-red); text-decoration: none; }

  /* Local section */
  .tll-local { background: var(--tll-ink); color: rgba(255, 255, 255, 0.85); }
  .tll-local .tll-h2 { color: #fff; }
  .tll-local .tll-eyebrow { color: #a9c3f5; }
  .tll-local .tll-rte strong { color: #fff; background: linear-gradient(transparent 60%, rgba(47, 123, 255, 0.45) 60%); }
  .tll-local__inner { display: grid; gap: 32px; }
  @media (min-width: 900px) { .tll-local__inner { grid-template-columns: 1fr 1fr; align-items: start; } }
  .tll-points { display: grid; gap: 12px; list-style: none; margin: 0; padding: 0; }
  .tll-point { display: flex; gap: 14px; padding: 18px; }
  .tll-point__icon { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: var(--tll-grad); color: #fff; flex-shrink: 0; }
  .tll-point h3 { font-size: 1.02rem; margin-bottom: 4px; }
  .tll-point p { margin: 0; font-size: 0.95rem; line-height: 1.5; opacity: 0.8; }

  /* Steps */
  .tll-steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; list-style: none; margin: 28px 0 0; padding: 0; counter-reset: none; }
  .tll-steps li { position: relative; padding: 26px; border-radius: var(--tll-radius); border: 1px solid var(--tll-line); background: linear-gradient(180deg, #fff, var(--tll-soft)); }
  .tll-steps__n { display: inline-block; margin-bottom: 14px; font-size: 2.2rem; font-weight: 800; letter-spacing: -0.04em; background: var(--tll-grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .tll-steps h3 { font-size: 1.15rem; color: var(--tll-ink); margin-bottom: 6px; }
  .tll-steps p { margin: 0; color: var(--tll-muted); line-height: 1.55; }
  .tll-qa { padding: 26px 28px; border-radius: var(--tll-radius); border: 1px solid var(--tll-line); border-left: 6px solid #0b5cff; background: var(--tll-soft); }
  .tll-qa .tll-h2 { font-size: clamp(1.3rem, 2.4vw, 1.7rem); }
  .tll-qa .tll-rte p { margin: 0.5em 0 0; line-height: 1.6; }
  .tll-compare { margin-top: 22px; overflow-x: auto; border-radius: var(--tll-radius); border: 1px solid var(--tll-line); }
  .tll-compare table { width: 100%; min-width: 520px; border-collapse: collapse; background: #fff; }
  .tll-compare th, .tll-compare td { padding: 14px 16px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--tll-line); line-height: 1.45; }
  .tll-compare thead th { background: var(--tll-ink); color: #fff; font-size: 0.95rem; }
  .tll-compare thead th.tll-compare__us { background: #0b5cff; }
  .tll-compare tbody th { font-weight: 700; color: var(--tll-ink); width: 30%; }
  .tll-compare td.tll-compare__us { font-weight: 600; color: var(--tll-ink); background: rgba(11, 92, 255, 0.05); }
  .tll-compare tbody tr:last-child th, .tll-compare tbody tr:last-child td { border-bottom: 0; }

  /* Gallery */
  .tll-gallery { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 24px; }
  @media (min-width: 900px) { .tll-gallery { grid-template-columns: repeat(4, 1fr); } }
  .tll-gallery__item { margin: 0; overflow: hidden; border-radius: 16px; background: var(--tll-soft); }
  .tll-gallery__item img { display: block; width: 100%; height: 100%; aspect-ratio: 1; object-fit: cover; transition: transform 0.4s ease; }
  .tll-gallery__item:hover img { transform: scale(1.04); }

  /* Chips */
  .tll-chips { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; margin: 0; padding: 0; }
  .tll-chips li { display: inline-flex; align-items: center; gap: 6px; padding: 10px 16px; border-radius: 999px; background: var(--tll-soft); border: 1px solid var(--tll-line); font-weight: 600; color: var(--tll-ink); }
  .tll-chips svg { color: var(--tll-red); width: 1em; height: 1em; }

  /* Price panel */
  .tll-price { display: grid; gap: 24px; padding: clamp(24px, 4vw, 48px); border-radius: 28px; color: rgba(255, 255, 255, 0.85); background: radial-gradient(600px 300px at 100% 0%, rgba(47, 123, 255, 0.45), transparent 60%), var(--tll-ink-2); }
  @media (min-width: 900px) { .tll-price { grid-template-columns: 1.1fr 1fr; align-items: center; } .tll-price__ctas { grid-column: 1 / -1; } }
  .tll-price .tll-h2 { color: #fff; }
  .tll-price p { margin: 0; line-height: 1.6; }
  .tll-price__list { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; list-style: none; margin: 0; padding: 0; }
  .tll-price__list li { display: flex; align-items: center; gap: 10px; padding: 14px; border-radius: 14px; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.1); font-weight: 600; font-size: 0.95rem; color: #fff; }
  .tll-price__list svg { color: #ff8a98; }
  .tll-price__ctas { display: flex; flex-wrap: wrap; gap: 12px; }

  /* Quote form */
  .tll-quote { display: grid; gap: 28px; padding: clamp(20px, 4vw, 44px); border-radius: 28px; background: var(--tll-soft); border: 1px solid var(--tll-line); }
  @media (min-width: 900px) { .tll-quote { grid-template-columns: 0.8fr 1.2fr; } }
  .tll-quote__intro p { margin: 0 0 18px; color: var(--tll-muted); line-height: 1.6; }
  .tll-quote__call { display: inline-flex; align-items: center; gap: 10px; color: var(--tll-ink); text-decoration: none; font-size: 1.05rem; }
  .tll-quote__call svg { color: var(--tll-red); }
  .tll-form { display: grid; gap: 16px; padding: clamp(18px, 3vw, 28px); border-radius: 20px; background: #fff; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.07); }
  .tll-progress { height: 6px; border-radius: 99px; background: var(--tll-soft); overflow: hidden; display: none; }
  .tll-form.is-stepped .tll-progress { display: block; }
  .tll-progress span { display: block; height: 100%; width: 33%; background: var(--tll-grad); border-radius: inherit; transition: width 0.3s ease; }
  .tll-form__step-label { margin: 0; font-size: 0.8rem; font-weight: 700; color: var(--tll-muted); text-transform: uppercase; letter-spacing: 0.08em; }
  .tll-form__step-label:empty { display: none; }
  .tll-step { display: grid; gap: 14px; margin: 0; padding: 0; border: 0; min-width: 0; }
  .tll-step[hidden] { display: none; }
  .tll-step legend { padding: 0; margin-bottom: 4px; font-size: 1.25rem; font-weight: 800; color: var(--tll-ink); }
  .tll-row { display: grid; gap: 14px; }
  @media (min-width: 600px) { .tll-row { grid-template-columns: 1fr 1fr; } }
  .tll-field { display: grid; gap: 6px; font-weight: 600; font-size: 0.92rem; color: var(--tll-ink); }
  .tll-field input, .tll-field textarea { width: 100%; min-height: 52px; padding: 13px 16px; border: 1.5px solid #d9d9e0; border-radius: 14px; background: #fff; font: inherit; font-size: 16px; font-weight: 500; color: var(--tll-ink); transition: border-color 0.15s ease, box-shadow 0.15s ease; }
  .tll-field textarea { resize: vertical; }
  .tll-field input:focus, .tll-field textarea:focus { border-color: var(--tll-red); box-shadow: 0 0 0 4px rgba(11, 92, 255, 0.12); outline: none; }
  .tll-field__hint { margin: 0; font-weight: 600; font-size: 0.92rem; color: var(--tll-ink); }
  .tll-options { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .tll-options label { position: relative; }
  .tll-options input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .tll-options span { display: grid; place-items: center; min-height: 48px; padding: 8px; border: 1.5px solid #d9d9e0; border-radius: 12px; font-weight: 600; font-size: 0.92rem; text-align: center; transition: all 0.15s ease; }
  .tll-options input:checked + span { border-color: var(--tll-red); background: rgba(11, 92, 255, 0.06); color: var(--tll-red); }
  .tll-options input:focus-visible + span { outline: 3px solid #a9c3f5; outline-offset: 2px; }
  .tll-form__nav { display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap; }
  .tll-form__nav .tll-btn { flex: 1 1 auto; }
  .tll-form__nav [hidden] { display: none; }
  .tll-form__fine { margin: 0; font-size: 0.8rem; color: var(--tll-muted); text-align: center; }
  .tll-form__error { padding: 12px 14px; border-radius: 12px; background: #fef2f2; color: #991b1b; font-weight: 600; }
  .tll-form__success { display: grid; gap: 12px; justify-items: start; }
  .tll-form__success > svg { width: 44px; height: 44px; color: var(--tll-green); }
  .tll-form__success h3 { font-size: 1.4rem; color: var(--tll-ink); }
  .tll-form__success p { margin: 0; color: var(--tll-muted); }

  /* FAQ */
  .tll-faq__list { display: grid; gap: 10px; margin-top: 24px; max-width: 860px; }
  .tll-faq__item { border-radius: 16px; border: 1px solid var(--tll-line); background: #fff; transition: border-color 0.2s ease, box-shadow 0.2s ease; }
  .tll-faq__item[open] { border-color: rgba(11, 92, 255, 0.35); box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06); }
  .tll-faq__item summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 20px; cursor: pointer; list-style: none; }
  .tll-faq__item summary::-webkit-details-marker { display: none; }
  .tll-faq__item h3 { font-size: 1.05rem; color: var(--tll-ink); }
  .tll-faq__plus { position: relative; width: 28px; height: 28px; border-radius: 50%; background: var(--tll-soft); flex-shrink: 0; }
  .tll-faq__plus::before, .tll-faq__plus::after { content: ""; position: absolute; top: 50%; left: 50%; width: 12px; height: 2px; background: var(--tll-red); transform: translate(-50%, -50%); transition: transform 0.2s ease; }
  .tll-faq__plus::after { transform: translate(-50%, -50%) rotate(90deg); }
  .tll-faq__item[open] .tll-faq__plus::after { transform: translate(-50%, -50%) rotate(0deg); }
  .tll-faq__item .tll-rte { padding: 0 20px 18px; color: var(--tll-muted); }

  /* Related links */
  .tll-links { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; list-style: none; margin: 20px 0 0; padding: 0; }
  .tll-links a { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; align-items: center; height: 100%; padding: 18px 20px; border-radius: 16px; border: 1px solid var(--tll-line); color: var(--tll-ink); text-decoration: none; transition: border-color 0.2s ease, transform 0.2s ease; }
  .tll-links a:hover, .tll-links a:focus-visible { border-color: var(--tll-red); transform: translateY(-2px); }
  .tll-links strong { grid-column: 1; }
  .tll-links span { grid-column: 1; font-size: 0.9rem; color: var(--tll-muted); }
  .tll-links svg { grid-column: 2; grid-row: 1 / span 2; color: var(--tll-red); }

  /* Mobile dock */
  .tll-dock { position: fixed; z-index: 40; left: 12px; right: 12px; bottom: calc(12px + env(safe-area-inset-bottom)); display: grid; grid-template-columns: 1fr auto; gap: 8px; padding: 8px; border-radius: 18px; background: rgba(7, 26, 61, 0.82); border: 1px solid rgba(255, 255, 255, 0.12); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35); }
  .tll-dock a { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 50px; padding: 0 18px; border-radius: 12px; font-weight: 800; text-decoration: none; }
  .tll-dock__call { background: var(--tll-grad); color: #fff; }
  .tll-dock__quote { background: #fff; color: var(--tll-ink); }
  @media (min-width: 900px) { .tll-dock { display: none; } }
  @media (max-width: 899px) { .tll { padding-bottom: 84px; } }

  /* Motion, only when the visitor allows it */
  @media (prefers-reduced-motion: no-preference) {
    .tll-live__dot { animation: tll-pulse 2s infinite; }
    .tll-hero__copy > * { animation: tll-rise 0.7s ease both; }
    .tll-hero__copy > *:nth-child(2) { animation-delay: 0.06s; }
    .tll-hero__copy > *:nth-child(3) { animation-delay: 0.12s; }
    .tll-hero__copy > *:nth-child(4) { animation-delay: 0.18s; }
    .tll-hero__media { animation: tll-rise 0.9s 0.1s ease both; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tll *, .tll *::before, .tll *::after { transition: none !important; animation: none !important; }
  }
  @keyframes tll-pulse { 0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.55); } 70% { box-shadow: 0 0 0 10px rgba(34, 197, 94, 0); } 100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); } }
  @keyframes tll-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  /* Deep blue call-first extras */
  .tll-art { position: absolute; inset: 0; width: 100%; height: 100%; }
  .tll-art__run { stroke-dasharray: 14 86; }
  .tll-art__rings circle { transform-origin: 1080px 90px; }
  .tll-btn--call { position: relative; overflow: hidden; padding-right: 16px; }
  .tll-ringer { position: relative; border-radius: 50% !important; }
  .tll-ringer::before, .tll-ringer::after { content: ""; position: absolute; inset: 0; border-radius: 50%; border: 2px solid rgba(255, 255, 255, 0.7); opacity: 0; }
  .tll-dial { white-space: nowrap; }
  .tll-dial span { display: inline-block; }
  .tll .tll-thin { flex: 0 0 26px; width: 26px; height: 12px; margin-left: 6px; stroke-width: 1.4; }
  .tll-shine::after { content: ""; position: absolute; top: 0; left: -60%; width: 40%; height: 100%; background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.35), transparent); transform: skewX(-20deg); pointer-events: none; }
  .tll-dock__call { justify-content: flex-start !important; padding: 0 12px 0 6px !important; }
  .tll-ringer--sm { display: grid; place-items: center; flex: 0 0 38px; width: 38px; height: 38px; background: rgba(255, 255, 255, 0.2); }
  .tll-dock__txt { display: flex; flex-direction: column; line-height: 1.15; min-width: 0; }
  .tll-dock__txt small { font-size: 0.7rem; font-weight: 700; opacity: 0.92; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tll-dock__txt .tll-dial { font-size: 1.1rem; }
  .tll-dock .tll-thin { margin-left: auto; }
  @media (prefers-reduced-motion: no-preference) {
    .tll-art__run { animation: tll-run 5s linear infinite; }
    .tll-art__rings circle { animation: tll-rings 3s ease-out infinite; }
    .tll-art__rings circle:nth-child(2) { animation-delay: 1s; } .tll-art__rings circle:nth-child(3) { animation-delay: 2s; }
    .tll-ringer svg { animation: tll-shake 2.4s infinite; }
    .tll-ringer::before, .tll-ringer::after { animation: tll-wave 2.4s infinite; }
    .tll-ringer::after { animation-delay: 0.8s; }
    .tll-dial span { animation: tll-hop 2.4s ease-in-out infinite; }
    .tll .tll-thin { animation: tll-nudge 1.6s ease-in-out infinite; }
    .tll-shine::after { animation: tll-sweep 3s ease-in-out infinite; }
  }
  @keyframes tll-run { from { stroke-dashoffset: 100; } to { stroke-dashoffset: 0; } }
  @keyframes tll-rings { 0% { opacity: 0; transform: scale(0.6); } 40% { opacity: 1; } 100% { opacity: 0; transform: scale(1.25); } }
  @keyframes tll-shake { 0%, 60%, 100% { transform: rotate(0); } 64% { transform: rotate(-16deg); } 68% { transform: rotate(14deg); } 72% { transform: rotate(-10deg); } 76% { transform: rotate(8deg); } 80% { transform: rotate(0); } }
  @keyframes tll-wave { 0% { transform: scale(1); opacity: 0.7; } 100% { transform: scale(1.8); opacity: 0; } }
  @keyframes tll-hop { 0%, 30%, 100% { transform: translateY(0); opacity: 1; } 12% { transform: translateY(-3px); opacity: 0.55; } }
  @keyframes tll-nudge { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(5px); } }
  @keyframes tll-sweep { 0%, 50% { left: -60%; } 100% { left: 130%; } }

  /* Delivery tracker + what we move */
  .tll-track { position: relative; z-index: 2; margin-top: -26px; margin-bottom: 8px; padding: 16px 16px 14px; background: #fff; border: 1px solid #dbe6ff; border-radius: 18px; box-shadow: 0 14px 34px rgba(7, 26, 61, 0.10); }
  .tll-track__line { position: relative; height: 30px; margin: 0 4px 8px; }
  .tll-track__line::before { content: ""; position: absolute; left: 0; right: 0; top: 50%; border-top: 3px dashed #b9cdfa; }
  .tll-track__van { position: absolute; top: 0; left: 0; display: grid; place-items: center; width: 44px; height: 30px; border-radius: 9px; background: #0b5cff; box-shadow: 0 4px 10px rgba(11, 92, 255, 0.35); }
  .tll .tll-track__van svg { width: 26px; height: 20px; stroke: #fff; fill: none; stroke-width: 1.8; }
  .tll-track__steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; list-style: none; margin: 0; padding: 0; }
  .tll-track__steps li { display: flex; gap: 8px; align-items: flex-start; min-width: 0; }
  .tll-track__steps b { flex: 0 0 24px; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: #e8f0ff; color: #0b5cff; font-size: 0.78rem; }
  .tll-track__steps strong { display: block; font-size: 0.92rem; color: #071a3d; line-height: 1.2; }
  .tll-track__steps span { display: block; font-size: 0.78rem; color: #5a6782; line-height: 1.3; }
  .tll-moves { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin-top: 14px; padding-top: 12px; border-top: 1px solid #e8f0ff; }
  .tll-moves__lbl { font-size: 0.74rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #0b5cff; }
  .tll-moves ul { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; flex: 1 1 320px; }
  .tll-moves li { display: inline-flex; align-items: center; gap: 5px; padding: 5px 10px; border-radius: 999px; background: #f5f8ff; border: 1px solid #dbe6ff; font-size: 0.82rem; font-weight: 600; color: #0a2a63; }
  .tll .tll-moves li svg { width: 13px; height: 13px; stroke: #0b5cff; stroke-width: 3; fill: none; }
  .tll-moves__call { display: inline-flex; align-items: center; gap: 7px; padding: 9px 14px; border-radius: 999px; background: #0b5cff; color: #fff; font-weight: 800; font-size: 0.9rem; text-decoration: none; white-space: nowrap; }
  .tll .tll-moves__call svg { width: 16px; height: 16px; stroke: #fff; fill: none; stroke-width: 2; }
  @media (max-width: 640px) {
    .tll-track { padding: 14px 12px 12px; }
    .tll-track__steps { gap: 6px; }
    .tll-track__steps li { flex-direction: column; align-items: center; text-align: center; gap: 4px; }
    .tll-track__steps strong { font-size: 0.78rem; }
    .tll-track__steps span { display: none; }
    .tll-moves__call { width: 100%; justify-content: center; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .tll-track__van { animation: tll-drive 7s ease-in-out infinite; }
  }
  @keyframes tll-drive { 0% { left: 0; } 85%, 100% { left: calc(100% - 44px); } }

  /* Blue + orange delivery theme */
  .tll { --tll-acc: #ff7a1a; --tll-acc-2: #ffa24d; --tll-acc-grad: linear-gradient(135deg, #ff7a1a 0%, #ffa24d 100%); }
  .tll-hero { background: radial-gradient(900px 420px at -5% 105%, rgba(255, 122, 26, 0.28), transparent 60%), radial-gradient(1200px 500px at 85% -10%, rgba(11, 92, 255, 0.4), transparent 60%), var(--tll-ink); }
  .tll-hero::after { content: ""; position: absolute; inset: 0; pointer-events: none; background-image: radial-gradient(rgba(255, 255, 255, 0.13) 1.3px, transparent 1.4px); background-size: 22px 22px; -webkit-mask-image: linear-gradient(115deg, transparent 35%, #000 100%); mask-image: linear-gradient(115deg, transparent 35%, #000 100%); }
  .tll-hero__inner { position: relative; z-index: 1; }
  .tll-art__run { stroke: #ffa24d; }
  .tll-art g[fill="#8fb4ff"] { fill: #ffa24d; }
  .tll-art__rings { stroke: rgba(255, 162, 77, 0.45); }
  .tll-h1 em { background: var(--tll-acc-grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .tll-kicker { color: #ffd0a6; border-color: rgba(255, 162, 77, 0.4); }
  .tll .tll-kicker svg { stroke: #ffa24d; }
  .tll-btn--call, .tll-dock__call, .tll-moves__call, .tll-live__call { background: var(--tll-acc-grad) !important; color: #071a3d !important; }
  .tll-btn--call { box-shadow: 0 10px 30px rgba(255, 122, 26, 0.45); }
  .tll-btn--call:hover { box-shadow: 0 14px 38px rgba(255, 122, 26, 0.6); }
  .tll .tll-btn--call svg, .tll .tll-dock__call svg, .tll .tll-moves__call svg, .tll .tll-live__call svg { stroke: #071a3d; }
  .tll-btn--call .tll-btn__icon, .tll-dock__call .tll-ringer--sm { background: rgba(7, 26, 61, 0.14); }
  .tll-ringer::before, .tll-ringer::after { border-color: rgba(7, 26, 61, 0.55); }
  .tll-shine::after { background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.55), transparent); }
  .tll-track__van { background: var(--tll-acc-grad); box-shadow: 0 4px 10px rgba(255, 122, 26, 0.4); }
  .tll .tll-track__van svg { stroke: #071a3d; fill: rgba(7, 26, 61, 0.12); }
  .tll-track__line::before { border-top-color: #ffc999; }
  .tll-track__steps b { background: #fff1e5; color: #d95f00; }
  .tll .tll-moves li svg { stroke: #ff7a1a; }
  .tll-moves__lbl { color: #d95f00; }
  /* duotone icon tiles */
  .tll-card { position: relative; overflow: hidden; }
  .tll-card::before { content: ""; position: absolute; left: 0; top: 0; width: 100%; height: 4px; background: linear-gradient(90deg, #0b5cff, #ff7a1a); opacity: 0; transition: opacity 0.2s; }
  .tll-card:hover::before { opacity: 1; }
  .tll-card__icon, .tll-point__icon { position: relative; display: grid !important; place-items: center; width: 58px !important; height: 58px !important; border-radius: 18px !important; background: linear-gradient(145deg, #0b5cff 0%, #0a2a63 100%) !important; box-shadow: 0 10px 22px rgba(11, 92, 255, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.25); }
  .tll-card__icon::after, .tll-point__icon::after { content: ""; position: absolute; right: -5px; top: -5px; width: 18px; height: 18px; border-radius: 50%; background: var(--tll-acc-grad); border: 3px solid #fff; }
  .tll-point__icon::after { border-color: #0a2a63; }
  .tll .tll-card__icon svg, .tll .tll-point__icon svg { width: 30px; height: 30px; stroke: #fff; stroke-width: 1.7; fill: rgba(255, 255, 255, 0.2); }
  .tll-steps__n { background: var(--tll-acc-grad) !important; -webkit-background-clip: text !important; background-clip: text !important; color: transparent !important; }
  .tll-eyebrow::before { content: ""; display: inline-block; width: 22px; height: 3px; margin-right: 8px; vertical-align: middle; border-radius: 2px; background: var(--tll-acc-grad); }
  .tll-rte strong { background: linear-gradient(transparent 60%, rgba(255, 122, 26, 0.25) 60%); }
  .tll-card__link { color: #d95f00; }
  .tll .tll-card__link svg { stroke: #d95f00; }

  .tll-cstrip { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 20px; margin-block: 8px 28px; padding: 16px 18px; border-radius: 18px; background: linear-gradient(135deg, #071a3d 0%, #0a2a63 100%); box-shadow: 0 12px 30px rgba(7, 26, 61, 0.18); }
  .tll-cstrip p { margin: 0; flex: 1 1 240px; color: #fff; font-weight: 700; font-size: 1.02rem; line-height: 1.35; }
  @media (max-width: 640px) { .tll-cstrip .tll-btn--call { width: 100%; justify-content: flex-start; } }

  .tll-card__photo { display: block; width: calc(100% + 48px); max-width: none; height: 150px; margin: -24px -24px 0; object-fit: cover; border-radius: var(--tll-radius) var(--tll-radius) 0 0; }
  .tll-card__icon--on-photo { margin-top: -40px; border: 3px solid #fff; }
{% endstylesheet %}

