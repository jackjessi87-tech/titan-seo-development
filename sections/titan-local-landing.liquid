    when 'single-item-delivery-sydney'
      assign moves = 'One couch|One bed|One fridge|One table|One wardrobe|One washing machine'
    when 'small-removals-sydney'
      assign moves = 'Studios|1-bedroom units|Share-house rooms|Part loads|Storage runs|Student moves'
    when 'couch-delivery'
      assign moves = '2 & 3-seater sofas|Modular lounges|Recliners|Sofa beds|Armchairs|Marketplace couches'
    when 'marketplace-pickup-delivery'
      assign moves = 'Couches|Beds & mattresses|Tables & chairs|Fridges & washers|Wardrobes|Free finds'
    when 'washing-machine-delivery-sydney'
      assign moves = 'Front loaders|Top loaders|Dryers|Washer-dryer combos|Marketplace washers|Store pickups'
    when 'furniture-courier-sydney'
      assign moves = 'Couches|Beds & mattresses|Tables & desks|Wardrobes|Fridges & washers|Marketplace buys'
    when 'van-and-driver-hire-sydney'
      assign moves = 'Furniture pickups|Small moves|Marketplace buys|Store collections|Appliances|Same-day runs'
    when 'two-men-and-a-van-sydney'
      assign moves = 'Heavy single items|Small moves|Fridges & washers|Marketplace pickups|Walk-up units|Same-day jobs'
    when 'dining-table-delivery-sydney'
      assign moves = 'Dining tables|Chairs|Glass & marble tops|Desks|Coffee tables|Marketplace tables'
    when 'wardrobe-delivery-sydney'
      assign moves = 'Wardrobes|Chests of drawers|Bookcases|Display cabinets|IKEA PAX|Marketplace wardrobes'
    when 'furniture-store-delivery-sydney'
      assign moves = 'Furniture store orders|Appliance store orders|IKEA click & collect|Bunnings orders|Floor stock|Warehouse pickups'
