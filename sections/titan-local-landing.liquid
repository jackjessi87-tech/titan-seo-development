{%- capture icon_pin -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>{%- endcapture -%}

<div class="tll" id="tll-{{ uid }}" data-open-hour="{{ s.open_hour }}" data-close-hour="{{ s.close_hour }}">

{%- capture cstrip -%}<div class="tll-wrap tll-cstrip"><p>%%T%%</p><a class="tll-btn tll-btn--call tll-shine" href="tel:{{ phone_intl }}"><span class="tll-btn__icon tll-ringer">{{ icon_phone }}</span><span class="tll-btn__label"><small>Call for {{ svc_esc }}</small><span class="tll-dial" aria-label="{{ s.phone }}">{{ dial }}</span></span>{{ icon_thin }}</a></div>{%- endcapture -%}
  {%- comment -%} Live status strip {%- endcomment -%}
  <div class="tll-live" role="status">
    <span class="tll-live__dot" aria-hidden="true"></span>
    <span class="tll-live__text" data-live-text>{{ s.live_fallback }}</span>
    <span class="tll-live__time" data-live-time></span>
    <a class="tll-live__call" href="tel:{{ phone_intl }}">{{ icon_phone }}<span>{{ s.phone }}</span></a>
  </div>

  {%- comment -%} Breadcrumbs {%- endcomment -%}
  <nav class="tll-crumbs tll-wrap" aria-label="Breadcrumb">
    <ol>
      <li><a href="{{ routes.root_url }}">Home</a></li>
      {%- if s.parent_label != blank and s.parent_url != blank -%}
        <li><a href="{{ s.parent_url }}">{{ s.parent_label }}</a></li>
      {%- endif -%}
      <li aria-current="page">{{ page.title }}</li>
    </ol>
  </nav>

  {%- comment -%} Hero {%- endcomment -%}
  <section class="tll-hero">
    <div class="tll-hero__grid-bg" aria-hidden="true">
      <svg class="tll-art" viewBox="0 0 1200 640" preserveAspectRatio="xMidYMid slice">
        <defs><pattern id="tll-topo-{{ uid }}" width="160" height="160" patternUnits="userSpaceOnUse"><path d="M0 40 C40 20 80 60 160 40 M0 80 C50 60 90 100 160 80 M0 120 C40 100 100 140 160 120" stroke="rgba(255,255,255,.06)" stroke-width="1.2" fill="none"/></pattern></defs>
        <rect width="1200" height="640" fill="url(#tll-topo-{{ uid }})" stroke="none"/>
        <g class="tll-art__rings" fill="none" stroke="rgba(143,180,255,.35)" stroke-width="1.5"><circle cx="1080" cy="90" r="40"/><circle cx="1080" cy="90" r="80"/><circle cx="1080" cy="90" r="120"/></g>
        <path d="M-20 560 C 200 460, 320 600, 520 500 S 860 360, 1080 90" fill="none" stroke="rgba(255,255,255,.22)" stroke-width="2.5" stroke-dasharray="2 14" stroke-linecap="round"/>
        <path class="tll-art__run" d="M-20 560 C 200 460, 320 600, 520 500 S 860 360, 1080 90" fill="none" stroke="#8fb4ff" stroke-width="3" stroke-linecap="round" pathLength="100"/>
        <g fill="#8fb4ff" stroke="none"><circle cx="520" cy="500" r="6"/><circle cx="1080" cy="90" r="8"/></g>
        <g fill="none" stroke="rgba(255,255,255,.14)" stroke-width="1.5"><path d="M60 120h40M80 100v40M980 520h30M995 505v30M640 80h24M652 68v24"/></g>
      </svg>
    </div>
    <div class="tll-wrap tll-hero__inner">
      <div class="tll-hero__copy">
        <p class="tll-kicker">{{ icon_pin }}<span>{{ s.kicker }}</span></p>
        <h1 class="tll-h1">{{ s.heading }}</h1>
        <p class="tll-hero__sub">{{ s.subheading }}</p>

        <div class="tll-hero__ctas">
          <a class="tll-btn tll-btn--call tll-shine" href="tel:{{ phone_intl }}"><span class="tll-btn__icon tll-ringer">{{ icon_phone }}</span><span class="tll-btn__label"><small>Call for {{ svc_esc }}</small><span class="tll-dial" aria-label="{{ s.phone }}">{{ dial }}</span></span>{{ icon_thin }}</a>
          <a class="tll-btn tll-btn--ghost" href="#tll-quote-{{ uid }}">Get my fixed price {{ icon_arrow }}</a>
        </div>

        <ul class="tll-trust" role="list">
          {%- if s.rating_text != blank -%}<li>{{ icon_star }}<span>{{ s.rating_text }}</span></li>{%- endif -%}
          {%- if s.trust_1 != blank -%}<li>{{ icon_shield }}<span>{{ s.trust_1 }}</span></li>{%- endif -%}
          {%- if s.trust_2 != blank -%}<li>{{ icon_bolt }}<span>{{ s.trust_2 }}</span></li>{%- endif -%}
        </ul>
      </div>

      <div class="tll-hero__media">
        {%- liquid
          assign hero_asset = blank
          case pg
            when 'fridge-movers-sydney'
              assign hero_asset = 'titan-job-french-fridge.jpg'
              assign hero_asset_alt = 'Fridge movers Sydney: French-door fridge standing upright in the Titan Express van with an appliance trolley'
            when 'fridge-washing-machine-delivery-sydney'
              assign hero_asset = 'titan-job-french-fridge.jpg'
              assign hero_asset_alt = 'French-door fridge standing upright in the Titan Express van with a trolley ready'
            when 'couch-delivery'
              assign hero_asset = 'titan-job-sofa.jpg'
              assign hero_asset_alt = 'Leather sofa strapped upright in the Titan Express van'
            when 'marketplace-pickup-delivery'
              assign hero_asset = 'titan-job-kerb-pickup.jpg'
              assign hero_asset_alt = 'Sofa sections and a coffee table waiting on the kerb beside the Titan Express van'
            when 'washing-machine-delivery-sydney'
              assign hero_asset = 'titan-job-washer-dock.jpg'
              assign hero_asset_alt = 'Wrapped fridge and front-loader washing machine on a dolly behind the Titan Express van'
            when 'bed-mattress-delivery-sydney'
              assign hero_asset = 'titan-job-mattress.jpg'
              assign hero_asset_alt = 'Mattress, boxed washing machine and wrapped furniture strapped in the van on an evening job'
            when 'furniture-store-delivery-sydney', 'ikea-pickup-delivery-sydney'
              assign hero_asset = 'titan-job-boxed.jpg'
              assign hero_asset_alt = 'Boxed furniture store order strapped upright in the Titan Express van'
            when 'bunnings-store-collection-sydney'
              assign hero_asset = 'titan-job-store-box.jpg'
              assign hero_asset_alt = 'Boxed fridge from a store beside the open Titan Express van'
            when 'dining-table-delivery-sydney'
              assign hero_asset = 'titan-job-tables.jpg'
              assign hero_asset_alt = 'Two outdoor tables and stools stacked and strapped in the Titan Express van'
            when 'small-removals-sydney'
              assign hero_asset = 'titan-job-small-load.jpg'
              assign hero_asset_alt = 'Cabinet, cupboard, chair and a box strapped in the van on a small move'
            when 'single-item-delivery-sydney', 'gumtree-pickup-delivery-sydney'
              assign hero_asset = 'titan-job-sofa-dolly.jpg'
              assign hero_asset_alt = 'Sofa standing on a dolly beside the open Titan Express van'
            when 'furniture-pickup-delivery-sydney'
              assign hero_asset = 'titan-job-wrapped-sofas.jpg'
              assign hero_asset_alt = 'Shrink-wrapped sofas loaded in the Titan Express van with a trolley'
            when 'man-with-a-van'
              assign hero_asset = 'titan-job-van-load.jpg'
              assign hero_asset_alt = 'Blanket-wrapped furniture, a trolley and an exercise bike loaded in the van'
            when 'same-day-removalists-sydney'
              assign hero_asset = 'titan-job-freezer.jpg'
              assign hero_asset_alt = 'Blanket-wrapped furniture and a chest freezer strapped in the Titan Express van'
            when 'wardrobe-delivery-sydney', 'student-removals-sydney'
              assign hero_asset = 'titan-job-room.jpg'
              assign hero_asset_alt = 'Blanket-wrapped furniture, a chest of drawers and an exercise bike strapped in the van'
            when 'furniture-courier-sydney', 'two-men-and-a-van-sydney', 'van-and-driver-hire-sydney'
              assign hero_asset = 'titan-job-wrapped.jpg'
              assign hero_asset_alt = 'Two blanket-wrapped items strapped in the Titan Express van outside an apartment block'
          endcase
        -%}
        {%- if hero_asset != blank -%}
          <img class="tll-hero__img" src="{{ hero_asset | asset_url }}" width="900" height="1120" loading="eager" fetchpriority="high" alt="{{ hero_asset_alt }}">
        {%- elsif s.hero_image != blank -%}
          {%- assign hero_alt = s.hero_image.alt | default: s.hero_alt -%}
          {{ s.hero_image | image_url: width: 900 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 900px) 42vw, 92vw', widths: '450, 700, 900', alt: hero_alt, class: 'tll-hero__img' }}
        {%- endif -%}
        <div class="tll-glass tll-hero__badge">
          <span class="tll-live__dot" aria-hidden="true"></span>
          <div><strong>{{ s.hero_badge_title }}</strong><span>{{ s.hero_badge_text }}</span></div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} Delivery tracker + what we move {%- endcomment -%}
  <div class="tll-wrap tll-track" aria-label="How your delivery runs">
    <div class="tll-track__line" aria-hidden="true"><span class="tll-track__van">{{ icon_van }}</span></div>
    <ol class="tll-track__steps" role="list">
      <li><b>1</b><div><strong>Call</strong><span>Fixed price on the phone</span></div></li>
      <li><b>2</b><div><strong>Pickup</strong><span>Two movers load the van</span></div></li>
      <li><b>3</b><div><strong>On the way</strong><span>Strapped in and wrapped</span></div></li>
      <li><b>4</b><div><strong>Delivered</strong><span>Carried into your room</span></div></li>
    </ol>
    <div class="tll-moves">
      <span class="tll-moves__lbl">We move</span>
      <ul role="list">{%- for m in moves -%}<li>{{ icon_check }}{{ m | escape }}</li>{%- endfor -%}</ul>
      <a class="tll-moves__call" href="tel:{{ phone_intl }}">{{ icon_phone }}<span>Call {{ s.phone }}</span></a>
    </div>
  </div>

  {%- comment -%} Search-intent cards {%- endcomment -%}
  {%- if intents.size > 0 -%}
    <section class="tll-section tll-wrap" aria-labelledby="tll-intents-{{ uid }}">
      <p class="tll-eyebrow">{{ s.intents_eyebrow }}</p>
      <h2 id="tll-intents-{{ uid }}" class="tll-h2">{{ s.intents_heading }}</h2>
      <ul class="tll-cards" role="list">
        {%- for block in intents -%}
          <li class="tll-card" {{ block.shopify_attributes }}>
            {%- liquid
              assign th = blank
              case block.settings.icon
                when 'sofa'
                  assign th = 'titan-th-sofa.jpg'
                when 'fridge'
                  assign th = 'titan-th-fridge.jpg'
                when 'box'
                  assign th = 'titan-th-box.jpg'
                when 'tag'
                  assign th = 'titan-th-wrap.jpg'
                when 'store'
                  assign th = 'titan-th-store.jpg'
              endcase
            -%}
            {%- if th != blank -%}<img class="tll-card__photo" src="{{ th | asset_url }}" width="240" height="240" loading="lazy" alt="">{%- endif -%}
            <span class="tll-card__icon{% if th != blank %} tll-card__icon--on-photo{% endif %}">
              {%- case block.settings.icon -%}
                {%- when 'sofa' -%}{{ icon_sofa }}
                {%- when 'box' -%}{{ icon_box }}
                {%- when 'tag' -%}{{ icon_tag }}
                {%- when 'store' -%}{{ icon_store }}
                {%- when 'fridge' -%}{{ icon_fridge }}
                {%- when 'bolt' -%}{{ icon_bolt }}
                {%- when 'stairs' -%}{{ icon_stairs }}
                {%- when 'building' -%}{{ icon_building }}
                {%- else -%}{{ icon_box }}
              {%- endcase -%}
            </span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
            {%- if block.settings.url != blank -%}
              <a class="tll-card__link" href="{{ block.settings.url }}">{{ block.settings.link_label | default: 'Learn more' }} {{ icon_arrow }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </section>
  {%- endif -%}

  {{ cstrip | replace: '%%T%%', 'See your job here? One call gets you a fixed price.' }}

