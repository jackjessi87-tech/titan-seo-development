{%- comment -%}
  Titan Express Quote form (2026-11-25): no price shown anywhere. The customer sends the route, items, optional photos, stairs and day,
  and Titan texts back a price. Made from the TX form (tx-quote.liquid), which stays as it is; this one uses its own names (tqf, tq-quote),
  so both can sit on the same page. Opens from [data-tq-open-quote], a [data-tq-quickstart] form, or any link ending in #quote-form.
  Sends through Shopify's contact form. Address search and route use free test services (Photon, OSRM, Esri tiles).
{%- endcomment -%}
{{ 'tq-quote.css' | asset_url | stylesheet_tag: preload: false }}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" media="print" onload="this.media='all'">
{%- assign s = section.settings -%}
{%- assign ph_team = images['titan-two-movers-truck-hero.webp'] -%}
{%- assign ph_gear = images['titan-fridge-trolley-ramp.webp'] -%}
{%- assign ph_done = images['titan-dining-table-two-movers.webp'] -%}
<div class="tqf" id="tqf" role="dialog" aria-modal="true" aria-labelledby="tqf-title" hidden data-phone="{{ s.phone }}" data-photo-variant="{{ s.photo_variant }}">
  <header class="tqf-top">
    <div class="tqf-row">
      <button class="tqf-ib" type="button" data-q-back aria-label="Back"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg></button>
      <img class="tqf-logo" src="{{ 'titan-favicon-192.png' | asset_url }}" alt="Titan Express" width="40" height="40">
      <div class="tqf-brand"><b id="tqf-title">Free quote</b><small data-q-steplbl>Step 1 of 5</small></div>
      <a class="tqf-help" href="tel:{{ s.phone | remove: ' ' | remove_first: '0' | prepend: '+61' }}"><svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>Call us</a>
      <button class="tqf-ib" type="button" data-q-close aria-label="Close"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    </div>
    <div class="tqf-prog" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
  </header>

  <div class="tqf-body">
    <!-- 1 route (laid out like the Yellow Express first screen, in Titan blue and white, 2026-11-24) -->
    <section class="tqf-s tqf-s1" data-s="1">
      <h2 class="tqf-h tqf-h--c">Where from,<br>where to?</h2>
      <div class="tqf-loc" data-row="from">
        <div class="tqf-lochd"><span class="tqf-lic"><svg viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span><label for="tqf-from">Pick up location</label></div>
        <input class="tqf-inp tqf-locinp" id="tqf-from" autocomplete="off" placeholder="e.g. company name, street or suburb">
        <div data-q-slot="from"></div>
        <input class="tqf-inp tqf-co" data-q-unita placeholder="Company name, unit or level" aria-label="Pickup company name, unit or level" hidden>
        <div class="tqf-cor"><button class="tqf-cobtn" type="button" data-q-cobtn="a">+ Add company name</button></div>
      </div>
      <div class="tqf-loc" data-row="to">
        <div class="tqf-lochd"><span class="tqf-lic"><svg viewBox="0 0 24 24"><path d="M5 21V4"/><path d="M5 4h14v9H5" /><path class="flag" d="M5 4h3.5v3H5zM12 4h3.5v3H12zM8.5 7H12v3H8.5zM15.5 7H19v3h-3.5zM5 10h3.5v3H5zM12 10h3.5v3H12z"/></svg></span><label for="tqf-to">Drop off location</label></div>
        <input class="tqf-inp tqf-locinp" id="tqf-to" autocomplete="off" placeholder="e.g. company name, street or suburb">
        <div data-q-slot="to"></div>
        <input class="tqf-inp tqf-co" data-q-unitb placeholder="Company name, unit or level" aria-label="Drop-off company name, unit or level" hidden>
        <div class="tqf-cor"><button class="tqf-cobtn" type="button" data-q-cobtn="b">+ Add company name</button></div>
      </div>
      <div class="tqf-card tqf-sugg" data-q-sugg hidden></div>
      <div class="tqf-premap">
        <div class="tqf-map" data-q-premap></div>
        <button class="tqf-cta tqf-confirm1" type="button" data-q-go1>CONFIRM LOCATIONS</button>
      </div>
    </section>

    <!-- 2 map -->
    <section class="tqf-s tqf-s--map" data-s="2" hidden>
      <div class="tqf-mapwrap">
        <div class="tqf-map" data-q-map></div>
        <div class="tqf-card tqf-floatcard"><div><i class="tqf-dot" style="background:#17357f"></i><span data-q-fa></span></div><div><i class="tqf-dot" style="background:#e1261c"></i><span data-q-fb></span></div></div>
        <div class="tqf-sheet">
          <div class="tqf-grab"></div>
          <div class="tqf-stats"><div><b data-q-km>…</b><span>driving distance</span></div><div><b data-q-min>…</b><span>drive time, no traffic</span></div></div>
          <button class="tqf-cta tqf-cta--block" type="button" data-q-confirm>CONFIRM LOCATIONS</button>
        </div>
      </div>
    </section>

    <!-- 3 items -->
    <section class="tqf-s tqf-s3" data-s="3" hidden>
      <p class="tqf-eb2">Large items <span>|</span> Select your items</p>
      <h2 class="tqf-h tqf-h--c">What are we moving?</h2>
      <div class="tqf-photos" data-q-photos>
        <label class="tqf-phbtn"><input type="file" accept="image/*" multiple data-q-phinput hidden><svg viewBox="0 0 24 24"><path d="M3 8h4l2-3h6l2 3h4v12H3z"/><circle cx="12" cy="13.5" r="3.5"/></svg><span data-q-phlbl>Add photos</span><em>optional</em></label>
        <p class="tqf-phsub">Photos help us send you an accurate quote faster.</p>
        <div class="tqf-phgrid" data-q-phgrid></div>
        <p class="tqf-phmsg" data-q-phmsg hidden></p>
      </div>
      <div class="tqf-ibox">
        <input data-q-custom placeholder="Item name…" aria-label="Type an item" autocomplete="off">
        <div class="tqf-ibq"><button type="button" data-q-cm aria-label="Fewer">−</button><span data-q-cq>1</span><button type="button" data-q-cp aria-label="More">+</button></div>
        <button class="tqf-iadd" type="button" data-q-cadd>Add</button>
      </div>
      <div class="tqf-chips" data-q-grid></div>
      <h3 class="tqf-h3" data-q-lh>Your list</h3>
      <div class="tqf-card tqf-list" data-q-list></div>
    </section>

    <!-- 4 crew, access, time -->
    <section class="tqf-s" data-s="4" hidden>
      <p class="tqf-eb">Step 3</p><h2 class="tqf-h">Stairs and day</h2>
      <p class="tqf-lede">Two quick questions and you're nearly done.</p>
      {%- if ph_gear != blank -%}
      <div class="tqf-team"><img src="{{ ph_gear | image_url: width: 240 }}" alt="Titan Express removalists moving a wrapped fridge on a trolley" width="240" height="240">
        <div><b>We send the right team for your job</b><span>{{ s.team_line }}</span></div></div>
      {%- endif -%}
      <h3 class="tqf-h3 tqf-h3--q">Any stairs?</h3>
      <div class="tqf-card tqf-stairs">
        <div class="tqf-strow"><div class="tqf-stl"><span class="tqf-pin tqf-pin--a">A</span><b>Pickup</b></div><div class="tqf-seg" data-q-seg="A"></div><div class="tqf-fl" data-q-fl="A" hidden></div></div>
        <div class="tqf-strow"><div class="tqf-stl"><span class="tqf-pin tqf-pin--b">B</span><b>Drop-off</b></div><div class="tqf-seg" data-q-seg="B"></div><div class="tqf-fl" data-q-fl="B" hidden></div></div>
      </div>
      <div class="tqf-card tqf-tog"><div><b>Dismantling or assembly</b><small>Bed frames, tables, wardrobes</small></div><button class="tqf-sw" type="button" data-q-dis aria-label="Dismantling or assembly"></button></div>
      <h3 class="tqf-h3 tqf-h3--q">When do you need it?</h3>
      <div class="tqf-when tqf-when--sm" data-q-when>
        <button type="button" data-w="today"><b>Today</b><svg viewBox="0 0 24 24"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg><small data-q-todaymsg></small></button>
        <button type="button" data-w="sched"><b>Pick a day</b><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4M7.5 14l1.5 1.5 3-3M13.5 15.5h3"/></svg></button>
      </div>
      <div class="tqf-dates" data-q-dates hidden></div>
      <div class="tqf-lbl tqf-lbl--big">Preferred time</div>
      <select class="tqf-inp tqf-timesel" data-q-timesel aria-label="Preferred time"></select>
    </section>

    <!-- 5 details -->
    <section class="tqf-s" data-s="5" hidden>
      <p class="tqf-eb">Step 4</p><h2 class="tqf-h">Your details</h2>
      <p class="tqf-lede">So we can text you your price. Nothing to pay now.</p>
      {%- if ph_team != blank -%}
      <div class="tqf-team"><img src="{{ ph_team | image_url: width: 240 }}" alt="Two Titan Express removalists loading a wrapped sofa" width="240" height="240">
        <div><b>A real person prices your job</b><span>Sam and the team check your details and photos, then text you your price.</span></div></div>
      {%- endif -%}
      {%- comment -%} The details boxes sit inside Shopify's contact form: tapping one loads Shopify's invisible spam check (hCaptcha),
      which the form needs before it can send. Job details travel in the hidden fields. {%- endcomment -%}
      {%- form 'contact', id: 'tqf-form', class: 'tqf-cform', data-q-form: '' -%}
    {%- if form.posted_successfully? -%}<span data-q-posted hidden></span>{%- endif -%}
    {%- if form.errors -%}<span data-q-errors hidden>{{ form.errors | default_errors | strip_html | strip }}</span>{%- endif -%}
    <input type="hidden" name="contact[source]" value="Quote form (no price)">
    <input type="hidden" name="contact[name]" data-f="name">
    <input type="hidden" name="contact[email]" data-f="email">
    <input type="hidden" name="contact[phone]" data-f="phone">
    <input type="hidden" name="contact[pickup_suburb]" data-f="pickup">
    <input type="hidden" name="contact[delivery_suburb]" data-f="dropoff">
    <input type="hidden" name="contact[items]" data-f="items">
    <input type="hidden" name="contact[crew]" data-f="crew">
    <input type="hidden" name="contact[stairs_or_lift]" data-f="access">
    <input type="hidden" name="contact[when]" data-f="when">
    <input type="hidden" name="contact[preferred_date]" data-f="date">
    <input type="hidden" name="contact[photos]" data-f="photos">
    <input type="hidden" name="contact[time_guide]" data-f="estimate">
    <input type="hidden" name="contact[body]" data-f="body">
  
      <div class="tqf-field"><label for="tqf-name">Name</label><input class="tqf-inp" id="tqf-name" autocomplete="name" placeholder="First name is fine"></div>
      <div class="tqf-field"><label for="tqf-phone">Mobile</label><input class="tqf-inp" id="tqf-phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="04xx xxx xxx"></div>
      <div class="tqf-field"><label for="tqf-email">Email</label><input class="tqf-inp" id="tqf-email" type="email" autocomplete="email" placeholder="you@example.com"></div>
      <div class="tqf-field"><label for="tqf-notes">Anything else? <span>(optional)</span></label><textarea class="tqf-inp" id="tqf-notes" rows="3" placeholder="e.g. narrow hallway, parking in the driveway"></textarea></div>
      {%- endform -%}
    </section>

    <!-- 6 review -->
    <section class="tqf-s" data-s="6" hidden>
      <p class="tqf-eb">Step 5</p><h2 class="tqf-h">Check and send</h2>
      <p class="tqf-lede">Check your details, then send. We'll text you a fixed price.</p>
      <div data-q-review></div>
    </section>

    <!-- 7 sent -->
    <section class="tqf-s" data-s="7" hidden>
      <div class="tqf-done">
        <div class="tqf-tick"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7"/></svg></div>
        <h2 class="tqf-h">Thanks, we've got it!</h2>
        {%- if ph_done != blank -%}<img class="tqf-donep" src="{{ ph_done | image_url: width: 840 }}" alt="Two Titan Express removalists carrying a wrapped dining table" width="840" height="840" loading="lazy">{%- endif -%}
        <p class="tqf-lede">Sam from Titan Express will text you your price shortly.<span data-q-donephoto> Got photos? Text them to <a href="sms:{{ s.phone | remove: ' ' }}">{{ s.phone }}</a> and we can price it exactly.</span></p>
        <a class="tqf-cta" href="tel:{{ s.phone | remove: ' ' | remove_first: '0' | prepend: '+61' }}">Call {{ s.phone }}</a>
      </div>
    </section>
  </div>

  <div class="tqf-foot" data-q-foot>
    <div class="tqf-sum" data-q-sum hidden><b data-q-sumn>0</b>items</div>
    <button class="tqf-cta" type="button" data-q-next disabled>NEXT</button>
  </div>

  <div class="tqf-scrim" data-q-scrim></div>
  <div class="tqf-bsheet" data-q-bsheet role="dialog" aria-modal="true"></div>
  <div class="tqf-toast" data-q-toast></div>

</div>
<script>
  /* the item icons and the map library are shared with the TX form; load each once only */
  document.addEventListener('DOMContentLoaded', function () {
    var add = function (src) { var s = document.createElement('script'); s.src = src; document.head.appendChild(s); };
    if (!window.TITAN_ICONS) add({{ 'tx-quote-icons.js' | asset_url | json }});
    if (!window.L) add('https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js');
  });
</script>
<script src="{{ 'tq-quote.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Quote form (no price)",
  "tag": "div",
  "class": "section-tq-quote",
  "settings": [
    { "type": "text", "id": "phone", "label": "Phone", "default": "0469 717 535" },
    { "type": "text", "id": "team_line", "label": "Team line (stairs step)", "default": "Experienced removalists, 10+ years. Trolleys, ramps and blankets on the truck." },
    { "type": "header", "content": "Customer photos" },
    { "type": "text", "id": "photo_variant", "label": "Variant ID used to store photos", "info": "Leave empty to switch photo upload off.", "default": "68154838843497" }
  ],
  "presets": [{ "name": "Quote form (no price)" }]
}
{% endschema %}
