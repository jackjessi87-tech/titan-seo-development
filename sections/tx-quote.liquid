{%- comment -%}
  Titan Express instant quote (redesign 2026-11). A full-screen overlay opened by any [data-tx-open-quote] link or the hero quick start.
  Sends through Shopify's contact form (same inbox and the same "New customer message" emails as the existing forms).
  Address search and route use free test services (Photon, OSRM, Esri tiles). Switch to Google Maps with Titan's own key before going live.
{%- endcomment -%}
{{ 'tx-quote.css' | asset_url | stylesheet_tag: preload: false }}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" media="print" onload="this.media='all'">
{%- assign s = section.settings -%}
<div class="txq" id="txq" role="dialog" aria-modal="true" aria-labelledby="txq-title" hidden data-phone="{{ s.phone }}" data-rate-first="{{ s.rate_first }}" data-rate-block="{{ s.rate_block }}" data-after-first="{{ s.after_first }}" data-after-block="{{ s.after_block }}" data-pri-first="{{ s.pri_first }}" data-pri-block="{{ s.pri_block }}" data-exp-first="{{ s.exp_first }}" data-exp-block="{{ s.exp_block }}" data-deposit-variant="{{ s.deposit_variant }}" data-deposit="{{ s.deposit_amount }}">
  <header class="txq-top">
    <div class="txq-row">
      <button class="txq-ib" type="button" data-q-back aria-label="Back"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg></button>
      <img class="txq-logo" src="{{ 'titan-favicon-192.png' | asset_url }}" alt="Titan Express" width="40" height="40">
      <div class="txq-brand"><b id="txq-title">Instant quote</b><small data-q-steplbl>Step 1 of 5</small></div>
      <a class="txq-help" href="tel:{{ s.phone | remove: ' ' | remove_first: '0' | prepend: '+61' }}"><svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>Need help?</a>
      <button class="txq-ib" type="button" data-q-close aria-label="Close"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    </div>
    <div class="txq-prog" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
  </header>

  <div class="txq-body">
    <!-- 1 route (laid out like the Yellow Express first screen, in Titan blue and white, 2026-11-24) -->
    <section class="txq-s txq-s1" data-s="1">
      <h2 class="txq-h txq-h--c">Where from,<br>where to?</h2>
      <div class="txq-loc" data-row="from">
        <div class="txq-lochd"><span class="txq-lic"><svg viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span><label for="txq-from">Pick up location</label></div>
        <input class="txq-inp txq-locinp" id="txq-from" autocomplete="off" placeholder="e.g. company name, street or suburb">
        <div data-q-slot="from"></div>
        <input class="txq-inp txq-co" data-q-unita placeholder="Company name, unit or level" aria-label="Pickup company name, unit or level" hidden>
        <div class="txq-cor"><button class="txq-cobtn" type="button" data-q-cobtn="a">+ Add company name</button></div>
        <div class="txq-away" data-q-away="A">
          <label class="txq-awayck"><input type="checkbox" data-q-awayck="A"><span>I won't be at the pickup location</span></label>
          <div class="txq-awayf" data-q-awayf="A" hidden>
            <label>Contact name<input class="txq-inp" data-q-cn="A" autocomplete="off" placeholder="e.g. John Smith"></label>
            <label>Contact number<input class="txq-inp" data-q-cp2="A" type="tel" inputmode="tel" autocomplete="off" placeholder="e.g. 0412 345 678"></label>
          </div>
        </div>
      </div>
      <div class="txq-loc" data-row="to">
        <div class="txq-lochd"><span class="txq-lic"><svg viewBox="0 0 24 24"><path d="M5 21V4"/><path d="M5 4h14v9H5" /><path class="flag" d="M5 4h3.5v3H5zM12 4h3.5v3H12zM8.5 7H12v3H8.5zM15.5 7H19v3h-3.5zM5 10h3.5v3H5zM12 10h3.5v3H12z"/></svg></span><label for="txq-to">Drop off location</label></div>
        <input class="txq-inp txq-locinp" id="txq-to" autocomplete="off" placeholder="e.g. company name, street or suburb">
        <div data-q-slot="to"></div>
        <input class="txq-inp txq-co" data-q-unitb placeholder="Company name, unit or level" aria-label="Drop-off company name, unit or level" hidden>
        <div class="txq-cor"><button class="txq-cobtn" type="button" data-q-cobtn="b">+ Add company name</button></div>
        <div class="txq-away" data-q-away="B">
          <label class="txq-awayck"><input type="checkbox" data-q-awayck="B"><span>I won't be at the drop-off location</span></label>
          <div class="txq-awayf" data-q-awayf="B" hidden>
            <label>Contact name<input class="txq-inp" data-q-cn="B" autocomplete="off" placeholder="e.g. John Smith"></label>
            <label>Contact number<input class="txq-inp" data-q-cp2="B" type="tel" inputmode="tel" autocomplete="off" placeholder="e.g. 0412 345 678"></label>
          </div>
        </div>
      </div>
      <div class="txq-card txq-sugg" data-q-sugg hidden></div>
      <div class="txq-premap">
        <div class="txq-map" data-q-premap></div>
        <button class="txq-cta txq-confirm1" type="button" data-q-go1>CONFIRM LOCATIONS</button>
      </div>
    </section>

    <!-- 2 map -->
    <section class="txq-s txq-s--map" data-s="2" hidden>
      <div class="txq-mapwrap">
        <div class="txq-map" data-q-map></div>
        <div class="txq-card txq-floatcard"><div><i class="txq-dot" style="background:#17357f"></i><span data-q-fa></span></div><div><i class="txq-dot" style="background:#e1261c"></i><span data-q-fb></span></div></div>
        <div class="txq-sheet">
          <div class="txq-grab"></div>
          <div class="txq-stats"><div><b data-q-km>…</b><span>driving distance</span></div><div><b data-q-min>…</b><span>drive time, no traffic</span></div></div>
          <button class="txq-cta txq-cta--block" type="button" data-q-confirm>CONFIRM LOCATIONS</button>
        </div>
      </div>
    </section>

    <!-- 3 items -->
    <section class="txq-s txq-s3" data-s="3" hidden>
      <p class="txq-eb2">Large items <span>|</span> Select your items</p>
      <h2 class="txq-h txq-h--c">What are we moving?</h2>
      <div class="txq-ibox">
        <input data-q-custom placeholder="Item name…" aria-label="Type an item" autocomplete="off">
        <div class="txq-ibq"><button type="button" data-q-cm aria-label="Fewer">−</button><span data-q-cq>1</span><button type="button" data-q-cp aria-label="More">+</button></div>
        <button class="txq-iadd" type="button" data-q-cadd>Add</button>
      </div>
      <div class="txq-chips" data-q-grid></div>
      <h3 class="txq-h3" data-q-lh>Your list</h3>
      <div class="txq-card txq-list" data-q-list></div>
    </section>

    <!-- 4 crew, access, time -->
    <section class="txq-s" data-s="4" hidden>
      <p class="txq-eb">Step 3</p><h2 class="txq-h">Crew, stairs and day</h2>
      <p class="txq-lede">Pick what suits you.</p>
      <div class="txq-crew" data-q-crew></div>
      <p class="txq-crewhint" data-q-crewhint></p>
      <label class="txq-ack" data-q-ackwrap hidden><input type="checkbox" data-q-ack><span>I understand I need to help load and unload the heavy items at both ends.</span></label>
      <div class="txq-card txq-acc"><div class="txq-acchd"><span class="txq-pin txq-pin--a">A</span><div><b>Pickup</b><small data-q-acca></small></div></div><div class="txq-lbl">How do we get the items out?</div><div class="txq-seg" data-q-seg="A"></div><div class="txq-fl" data-q-fl="A" hidden><span>Flights of stairs</span><div class="txq-step txq-step--sm"><button type="button">−</button><span>1</span><button type="button">+</button></div></div></div>
      <div class="txq-card txq-acc"><div class="txq-acchd"><span class="txq-pin txq-pin--b">B</span><div><b>Drop-off</b><small data-q-accb></small></div></div><div class="txq-lbl">How do we get the items in?</div><div class="txq-seg" data-q-seg="B"></div><div class="txq-fl" data-q-fl="B" hidden><span>Flights of stairs</span><div class="txq-step txq-step--sm"><button type="button">−</button><span>1</span><button type="button">+</button></div></div></div>
      <div class="txq-card txq-tog"><div><b>Dismantling or assembly</b><small>Bed frames, tables, wardrobes</small></div><button class="txq-sw" type="button" data-q-dis aria-label="Dismantling or assembly"></button></div>
      <!-- When is your booking for? (laid out like Yellow Express, 2026-11-24) -->
      <h3 class="txq-wh">When is your booking for?</h3>
      <div class="txq-when" data-q-when>
        <button type="button" data-w="today"><b>Today</b><svg viewBox="0 0 24 24"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg><small data-q-todaymsg></small></button>
        <button type="button" data-w="sched"><b>Schedule</b><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4M7.5 14l1.5 1.5 3-3M13.5 15.5h3"/></svg></button>
      </div>
      <div class="txq-dates" data-q-dates hidden></div>
      <div class="txq-lbl txq-lbl--big">Select time</div>
      <select class="txq-inp txq-timesel" data-q-timesel required aria-label="Pickup window start time"></select>
      <div class="txq-winhd"><b>Choose a pickup window start time</b><button type="button" data-q-wininfo aria-label="What is the pickup window?"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.01"/></svg></button></div>
      <p class="txq-wininfo" data-q-wininfotxt hidden>This is the time we start the pickup. For a future date we come at your booked time. For today, Standard comes any time from then, Priority within 4 hours, and Express goes straight there. We text you when we are on the way.</p>
      <div data-q-svc aria-live="polite"></div>
    </section>

    <!-- 5 details -->
    <section class="txq-s" data-s="5" hidden>
      <p class="txq-eb">Step 4</p><h2 class="txq-h">Your details</h2>
      <p class="txq-lede">We text you to confirm the time. Nothing to pay now.</p>
      <div class="txq-note"><svg viewBox="0 0 24 24"><path d="M3 8h4l2-3h6l2 3h4v12H3z"/><circle cx="12" cy="13.5" r="3.5"/></svg>
        <span>Photos help us give an exact price. After sending, text them to <a href="sms:{{ s.phone | remove: ' ' }}">{{ s.phone }}</a>, no rush.</span></div>
      {%- comment -%} The details boxes sit inside Shopify's contact form: tapping one loads Shopify's invisible spam check (hCaptcha),
      which the form needs before it can send. Job details travel in the hidden fields. {%- endcomment -%}
      {%- form 'contact', id: 'txq-form', class: 'txq-cform', data-q-form: '' -%}
    {%- if form.posted_successfully? -%}<span data-q-posted hidden></span>{%- endif -%}
    {%- if form.errors -%}<span data-q-errors hidden>{{ form.errors | default_errors | strip_html | strip }}</span>{%- endif -%}
    <input type="hidden" name="contact[source]" value="Instant quote (new design)">
    <input type="hidden" name="contact[name]" data-f="name">
    <input type="hidden" name="contact[email]" data-f="email">
    <input type="hidden" name="contact[phone]" data-f="phone">
    <input type="hidden" name="contact[pickup_suburb]" data-f="pickup">
    <input type="hidden" name="contact[delivery_suburb]" data-f="dropoff">
    <input type="hidden" name="contact[items]" data-f="items">
    <input type="hidden" name="contact[crew]" data-f="crew">
    <input type="hidden" name="contact[stairs_or_lift]" data-f="access">
    <input type="hidden" name="contact[when]" data-f="when">
    <input type="hidden" name="contact[preferred_date]" data-f="date">
    <input type="hidden" name="contact[estimate]" data-f="estimate">
    <input type="hidden" name="contact[body]" data-f="body">
  
      <div class="txq-field"><label for="txq-name">Name</label><input class="txq-inp" id="txq-name" autocomplete="name" placeholder="First name is fine"></div>
      <div class="txq-field"><label for="txq-phone">Mobile</label><input class="txq-inp" id="txq-phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="04xx xxx xxx"></div>
      <div class="txq-field"><label for="txq-email">Email</label><input class="txq-inp" id="txq-email" type="email" autocomplete="email" placeholder="you@example.com"></div>
      <div class="txq-field"><label for="txq-notes">Anything else? <span>(optional)</span></label><textarea class="txq-inp" id="txq-notes" rows="3" placeholder="e.g. narrow hallway, parking in the driveway"></textarea></div>
      {%- endform -%}
    </section>

    <!-- 6 review -->
    <section class="txq-s" data-s="6" hidden>
      <p class="txq-eb">Step 5</p><h2 class="txq-h">Check and send</h2>
      <p class="txq-lede">Check your details, then send.</p>
      <div data-q-review></div>
      {%- comment -%} Shopify's own Google Pay / Apple Pay / Shop Pay buttons for the deposit, right on the form (2026-11-24) {%- endcomment -%}
      {%- assign dep = all_products['titan-booking-deposit'] -%}
      {%- if dep != blank and dep.available and s.deposit_variant != blank -%}
      <div class="txq-wallet" data-q-wallet>
        <p class="txq-wallet-h">Pay the {{ dep.price | money_without_trailing_zeros }} deposit in one tap</p>
        {%- form 'product', dep, class: 'txq-walletform', data-q-walletform: '' -%}
          <input type="hidden" name="id" value="{{ dep.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <div data-q-wprops></div>
          {{ form | payment_button }}
        {%- endform -%}
        <div class="txq-walletlock" data-q-walletlock>Tick the box above first</div>
        <p class="txq-wallet-or"><span>or pay by card with the red button below</span></p>
      </div>
      {%- endif -%}
    </section>

    <!-- 7 sent -->
    <section class="txq-s" data-s="7" hidden>
      <div class="txq-done">
        <div class="txq-tick"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7"/></svg></div>
        <h2 class="txq-h">Thanks, we've got it!</h2>
        <p class="txq-lede">Sam from Titan Express will text you shortly to confirm the time. Got photos? Text them to <a href="sms:{{ s.phone | remove: ' ' }}">{{ s.phone }}</a>.</p>
        <a class="txq-cta" href="tel:{{ s.phone | remove: ' ' | remove_first: '0' | prepend: '+61' }}">Call {{ s.phone }}</a>
      </div>
    </section>
  </div>

  <div class="txq-foot" data-q-foot>
    <div class="txq-sum" data-q-sum hidden><b data-q-sumn>0</b>items</div>
    <button class="txq-cta" type="button" data-q-next disabled>NEXT</button>
  </div>

  <div class="txq-scrim" data-q-scrim></div>
  <div class="txq-bsheet" data-q-bsheet role="dialog" aria-modal="true"></div>
  <div class="txq-toast" data-q-toast></div>

</div>
<script src="{{ 'tx-quote-icons.js' | asset_url }}" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js" defer></script>
<script src="{{ 'tx-quote.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "TX instant quote",
  "tag": "div",
  "class": "section-tx-quote",
  "settings": [
    { "type": "text", "id": "phone", "label": "Phone", "default": "0469 717 535" },
    { "type": "header", "content": "Hourly rates (dollars)" },
    { "type": "number", "id": "rate_first", "label": "Weekday: first 30 minutes", "default": 99 },
    { "type": "number", "id": "rate_block", "label": "Weekday: each extra 30 minutes", "default": 52 },
    { "type": "number", "id": "after_first", "label": "Weekend / evening: first 30 minutes", "default": 198 },
    { "type": "number", "id": "after_block", "label": "Weekend / evening: each extra 30 minutes", "default": 104 },
    { "type": "header", "content": "Faster services (weekdays before 5pm)" },
    { "type": "number", "id": "pri_first", "label": "Priority (within 4 hours): first 30 minutes", "default": 154 },
    { "type": "number", "id": "pri_block", "label": "Priority: each extra 30 minutes", "default": 81 },
    { "type": "number", "id": "exp_first", "label": "Express (ASAP, direct): first 30 minutes", "default": 198 },
    { "type": "number", "id": "exp_block", "label": "Express: each extra 30 minutes", "default": 104 },
    { "type": "header", "content": "Pay to book (Shopify checkout)" },
    { "type": "text", "id": "deposit_variant", "label": "Deposit product variant ID (leave empty to switch card payment off)", "default": "68154838843497" },
    { "type": "number", "id": "deposit_amount", "label": "Deposit shown on the button (must match the product price)", "default": 99 }
  ],
  "presets": [{ "name": "TX instant quote" }]
}
{% endschema %}
